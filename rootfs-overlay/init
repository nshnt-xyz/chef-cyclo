#!/bin/busybox sh
# chef-cyclo initramfs /init.
#
# The phone has no usable display or serial console at this stage, so this
# brings up a USB NCM network interface (phone = 172.16.42.1, DHCP for the
# host) and a root telnet shell on it, and hands over to busybox init.
# Progress is logged to the kernel log (readable later with dmesg) and
# signalled on the vibrator: one buzz when init starts, two when the USB
# network is up.

# The root is the read-only system_a filesystem (entered from the stage-1
# /init in the boot image) or, in the full RAM image, the initramfs itself.
# Either way this script writes nothing to /: the busybox applet links, the
# mountpoints and the D-Bus helper mode are made at build time
# (scripts/mkinitramfs.sh, scripts/mksystem.sh), and volatile state lives on
# tmpfs (/run, /tmp, /var, /root).
export PATH=/sbin:/usr/sbin:/bin:/usr/bin

log()  { echo "cyclo-init: $*" > /dev/kmsg 2>/dev/null; }
buzz() { echo "$1" > /sys/class/timed_output/vibrator/enable 2>/dev/null; }

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev || { mount -t tmpfs tmpfs /dev; mdev -s; }
mkdir -p /dev/pts
mount -t devpts   devpts   /dev/pts
mount -t tmpfs    tmpfs    /tmp
mount -t tmpfs    tmpfs    /run
# Our runtime files live under /run/chef (docs/features/runtime-files.md),
# made before anything writes under /run. Root's and 0755, never group or
# world writable: root-only files (the SSH host key in /run/chef/ssh) sit
# below them. chef-state's own directory is here too: the services make
# their daemons' directories in it.
mkdir -p -m 0755 /run/chef /run/chef/log /run/chef/lock /run/chef/state
# The screen handover (fb0.lock, fb0.lit, off) for the screen group: group
# write on the directory lets one member remove a flag another made. The
# lock is made here, 0660, so a member can always open it, whoever opens it
# first.
if mkdir -m 0775 /run/chef/screen && chgrp screen /run/chef/screen &&
   : > /run/chef/screen/fb0.lock && chgrp screen /run/chef/screen/fb0.lock &&
   chmod 0660 /run/chef/screen/fb0.lock; then
    :
else
    log "screen handover directory not set up"
fi
mount -t configfs configfs /sys/kernel/config
# No hard link to a file one does not own, no following another user's
# symlink in a sticky world-writable directory: what every mainstream
# distribution sets (this kernel defaults both to 0). With protected
# hardlinks a daemon cannot link a root file into its own directory, so
# chef-storage's chown -R -h of a daemon's directory reaches only the
# daemon's own files.
{ echo 1 > /proc/sys/fs/protected_hardlinks && echo 1 > /proc/sys/fs/protected_symlinks; } 2>/dev/null ||
    log "fs.protected_hardlinks/protected_symlinks not set"
# The host name every syslog line carries (syslogd reads it once at start)
# and the shell prompt shows; nothing else applies /etc/hostname.
hostname -F /etc/hostname || log "hostname not set from /etc/hostname"

# Volatile /var: a tmpfs seeded with the image's /var (NetworkManager, dbus,
# chrony, bluetooth, log, cache), so services keep writing there as they did
# in the all-RAM root; chef-storage binds /data over parts of it. root's
# home (shell history, PipeWire state) is a tmpfs too.
if mkdir -p /run/.var && mount -t tmpfs -o mode=755 tmpfs /run/.var &&
   cp -a /var/. /run/.var/ && mount --move /run/.var /var; then
    rmdir /run/.var
else
    log "volatile /var setup failed"
fi
mount -t tmpfs -o mode=700 tmpfs /root || log "volatile /root setup failed"
if grep -q '^/dev/[^ ]* / ext4 ro[ ,]' /proc/mounts; then
    log "root: read-only system_a"
else
    log "root: RAM"
fi

mkdir -p /run/dbus /var/lib/dbus
dbus-uuidgen --ensure 2>/dev/null
# chronyd (-u chrony) needs its socket and drift directories its own;
# chef-storage boot binds /data/v1/chrony (made the same way) over the
# second when /data is ours.
mkdir -p /run/chrony /var/lib/chrony && chown chrony:chrony /run/chrony /var/lib/chrony &&
    chmod 700 /run/chrony /var/lib/chrony || log "chrony directories not set up; chronyd may not start"

# polkitd (as polkitd) reads /etc/polkit-1/rules.d, which polkit-common
# ships root:polkitd 0750; apk --usermode drops the group. system_a has it
# from the build; set it in the RAM cpio. Without it polkitd logs an error
# on each rules load (ours are in /usr/share/polkit-1/rules.d).
RULES=/etc/polkit-1/rules.d
[ "$(stat -c '%u:%g %a' "$RULES")" = '0:206 750' ] ||
    { chown root:polkitd "$RULES" && chmod 0750 "$RULES"; } ||
    log "polkit rules directory not set up; polkitd cannot read it"

# apk --usermode/no-scripts omit the privileged activation helper metadata.
# Only the system-bus account may execute this root helper. system_a has it
# from the build (uid 0, gid 101 messagebus, 4750); the RAM cpio is all
# root-owned and writable, so set it there.
HELPER=/usr/libexec/dbus-daemon-launch-helper
if [ "$(stat -c '%u:%g %a' "$HELPER")" = '0:101 4750' ] ||
   { chown root:messagebus "$HELPER" && chmod 4750 "$HELPER"; }; then
    touch /run/chef/dbus-helper-ready
else
    log "D-Bus launch-helper setup failed; system bus will remain unavailable"
fi

log "starting ($(uname -r))"
buzz 150

# gpsd and nmea-broker communicate over loopback, and gpsd's client socket is
# loopback-only by default. A bare initramfs does not configure lo for us.
if ip link set lo up 2>/dev/null &&
   { ip addr add 127.0.0.1/8 dev lo 2>/dev/null ||
     ip addr show dev lo 2>/dev/null | grep -q 'inet 127\.0\.0\.1/8'; }; then
    log "loopback up, 127.0.0.1/8"
else
    log "failed to configure loopback"
fi

# --- USB gadget: one NCM ethernet function, via configfs ------------------
# Shared with the stage-1 rescue shell. A failed `.` would end this shell
# (PID 1), so a missing helper only costs the USB network. Its files go to
# /run/chef here; stage 1 keeps the helper's default, /run.
USB_GADGET_RUN=/run/chef
if [ -r /usr/lib/chef/usb-gadget.sh ] && . /usr/lib/chef/usb-gadget.sh; then
    if usb_gadget_up; then
        buzz 150; sleep 0.3; buzz 150
    fi
else
    log "USB gadget helper missing; no USB network"
fi

# Initialize native device metadata before NetworkManager starts. Preserve
# kernel names; packaged eudev has no predictive net-renaming rule.
# Coldplug only what needs it, about 10 ms each: net for NetworkManager,
# and the nodes our non-root daemons open, where the stock rules give
# event* (input) the input group and fb0 (graphics) the video group, and
# 70-chef.rules /dev/sensors (ssc) the sensord group, the backlight's
# brightness (leds) video, the vibrator's enable (timed_output) vibrator
# and /dev/uinput the uinput group. uinput is the one misc node wanted:
# its own trigger, since --sysname-match in the first one would filter
# every subsystem by that name. Storage stays out (probing it delayed boot
# and settle timed out on this kernel), and so does power_supply (0.4 s
# for the battery alone; powerd's service sets system_temp_level's group
# instead). Other nodes remain devtmpfs (mdev fallback); new device events
# are still handled by the resident udev daemon.
mkdir -p /run/udev
if /sbin/udevd --daemon; then
    if udevadm trigger --action=add --subsystem-match=net --subsystem-match=input \
           --subsystem-match=graphics --subsystem-match=leds --subsystem-match=timed_output \
           --subsystem-match=ssc &&
       udevadm trigger --action=add --subsystem-match=misc --sysname-match=uinput &&
       udevadm settle --timeout=20; then
        touch /run/chef/udev-ready
    else
        log "udev coldplug failed; NetworkManager will remain unavailable and device nodes stay root-only"
    fi
else
    log "udev initialization failed; NetworkManager will remain unavailable"
fi

# Reserve WLAN ownership before any concurrent init consumers exist.
# No manual supplicant/DHCP may run in this standard-NM image, even on failure.
touch /run/chef/wifi-nm-mode

# Hand over to busybox init: /etc/inittab keeps telnetd running and starts
# OpenRC, which starts the services (docs/features/services.md).
/usr/bin/chef-storage boot || log "storage boot failed; continuing RAM-only"
# Clock from the saved RTC offset, the previous boot's pstore records and a
# boot history line, on /data (chef-state; RAM-only: /run/chef/state/time only).
# Bounded: nothing in it may hold up the boot.
/usr/bin/timeout -k 2 25 /usr/bin/chef-state boot || log "state restore failed; continuing"
# syslogd's /dev/log queue: the kernel default of 10 datagrams fills in the
# boot burst (every daemon starting at once), after which chef_log falls
# back to kmsg and syslog(3) callers block. 512, as systemd sets at boot.
echo 512 > /proc/sys/net/unix/max_dgram_qlen 2>/dev/null || log "max_dgram_qlen not set; /dev/log queue stays at the kernel default"
log "exec init"
exec /sbin/init
