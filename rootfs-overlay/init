#!/bin/busybox sh
# chef-cyclo initramfs /init.
#
# The phone has no usable display or serial console at this stage, so this
# brings up a USB NCM network interface (phone = 172.16.42.1, DHCP for the
# host) and a root telnet shell on it, and hands over to busybox init.
# Progress is logged to the kernel log (readable later with dmesg) and
# signalled on the vibrator: one buzz when init starts, two when the USB
# network is up.

# The root is the read-only system_a filesystem (entered from the stage-1
# /init in the boot image) or, in the full RAM image, the initramfs itself.
# Either way this script writes nothing to /: the busybox applet links, the
# mountpoints and the D-Bus helper mode are made at build time
# (scripts/mkinitramfs.sh, scripts/mksystem.sh), and volatile state lives on
# tmpfs (/run, /tmp, /var, /root).
export PATH=/sbin:/usr/sbin:/bin:/usr/bin

log()  { echo "cyclo-init: $*" > /dev/kmsg 2>/dev/null; }
buzz() { echo "$1" > /sys/class/timed_output/vibrator/enable 2>/dev/null; }

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev || { mount -t tmpfs tmpfs /dev; mdev -s; }
mkdir -p /dev/pts
mount -t devpts   devpts   /dev/pts
mount -t tmpfs    tmpfs    /tmp
mount -t tmpfs    tmpfs    /run
mount -t configfs configfs /sys/kernel/config

# Volatile /var: a tmpfs seeded with the image's /var (NetworkManager, dbus,
# chrony, bluetooth, log, cache), so services keep writing there as they did
# in the all-RAM root; chef-storage binds /data over parts of it. root's
# home (shell history, PipeWire state) is a tmpfs too.
if mkdir -p /run/.var && mount -t tmpfs -o mode=755 tmpfs /run/.var &&
   cp -a /var/. /run/.var/ && mount --move /run/.var /var; then
    rmdir /run/.var
else
    log "volatile /var setup failed"
fi
mount -t tmpfs -o mode=700 tmpfs /root || log "volatile /root setup failed"
if grep -q '^/dev/[^ ]* / ext4 ro[ ,]' /proc/mounts; then
    log "root: read-only system_a"
else
    log "root: RAM"
fi

mkdir -p /run/dbus /var/lib/dbus
dbus-uuidgen --ensure 2>/dev/null

# apk --usermode/no-scripts omit the privileged activation helper metadata.
# Only the system-bus account may execute this root helper. system_a has it
# from the build (uid 0, gid 101 messagebus, 4750); the RAM cpio is all
# root-owned and writable, so set it there.
HELPER=/usr/libexec/dbus-daemon-launch-helper
if [ "$(stat -c '%u:%g %a' "$HELPER")" = '0:101 4750' ] ||
   { chown root:messagebus "$HELPER" && chmod 4750 "$HELPER"; }; then
    touch /run/dbus-helper-ready
else
    log "D-Bus launch-helper setup failed; system bus will remain unavailable"
fi

log "starting ($(uname -r))"
buzz 150

# gpsd and nmea-broker communicate over loopback, and gpsd's client socket is
# loopback-only by default. A bare initramfs does not configure lo for us.
if ip link set lo up 2>/dev/null &&
   { ip addr add 127.0.0.1/8 dev lo 2>/dev/null ||
     ip addr show dev lo 2>/dev/null | grep -q 'inet 127\.0\.0\.1/8'; }; then
    log "loopback up, 127.0.0.1/8"
else
    log "failed to configure loopback"
fi

# --- USB gadget: one NCM ethernet function, via configfs ------------------
# Shared with the stage-1 rescue shell. A failed `.` would end this shell
# (PID 1), so a missing helper only costs the USB network.
if [ -r /usr/lib/chef/usb-gadget.sh ] && . /usr/lib/chef/usb-gadget.sh; then
    if usb_gadget_up; then
        buzz 150; sleep 0.3; buzz 150
    fi
else
    log "USB gadget helper missing; no USB network"
fi

# Initialize native device metadata before NetworkManager starts. Preserve
# kernel names; packaged eudev has no predictive net-renaming rule. Coldplug
# only net: probing every storage/input device delayed boot and settle timed
# out on this kernel. Existing nodes remain devtmpfs (mdev fallback); new
# device events are still handled by the resident udev daemon.
mkdir -p /run/udev
if /sbin/udevd --daemon; then
    if udevadm trigger --action=add --subsystem-match=net && udevadm settle --timeout=20; then
        touch /run/udev-ready
    else
        log "network udev initialization failed; NetworkManager will remain unavailable"
    fi
else
    log "udev initialization failed; NetworkManager will remain unavailable"
fi

# Reserve WLAN ownership before any concurrent init consumers exist.
# No manual supplicant/DHCP may run in this standard-NM image, even on failure.
touch /run/wifi-nm-mode

# Hand over to busybox init: /etc/inittab keeps telnetd, udhcpd, dbus,
# bluetoothd and the Bluetooth attach (bt-up) running.
/usr/bin/chef-storage boot || log "storage boot failed; continuing RAM-only"
# Clock from the saved RTC offset, the previous boot's pstore records and a
# boot history line, on /data (chef-state; RAM-only: /run/chef-time only).
# Bounded: nothing in it may hold up the boot.
/usr/bin/timeout -k 2 25 /usr/bin/chef-state boot || log "state restore failed; continuing"
log "exec init"
exec /sbin/init
