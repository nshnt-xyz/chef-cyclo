#!/bin/sh
# Bring the WCN3990 to the point where the kernel takes over: power it, send
# the power-on pulses, then hand /dev/ttyHS0 to hci_uart with the QCA
# protocol and stay attached.  Everything after that (version request, switch
# to 3.2 Mbaud, crbtfw/crnv download from /lib/firmware/qca, HCI reset, IBS
# sleep) happens in the kernel when BlueZ powers the adapter on.
#
# Run as the supervised OpenRC service bt-up: if btattach exits, this exits,
# and the next start power-cycles and re-attaches the controller.
#
# First of all, a btattach left by an earlier bt-up is stopped: when bt-up
# itself is killed (kill -9), its supervisor starts a new one, but the old
# btattach lives on in the old process group and keeps the UART, so the
# new attach would hang, and the service's stop_post only reaches the
# current group. Only bt-up starts btattach, so any running one is a
# leftover.
set -u

# The paths are overridable for the host test (tools/tests/test_bt_up.py).
UART=${BT_UP_UART:-/dev/ttyHS0}
BTPOWER=${BT_UP_BTPOWER:-/dev/btpower}
POWERED=${BT_UP_POWERED:-/run/chef/bt-powered}
CMDLINE=${BT_UP_CMDLINE:-/proc/cmdline}
# syslog through the shared helper (kmsg while syslogd is not up), and
# stdout
. "${CHEF_LIB_DIR:-/usr/lib/chef}/log.sh"
log() { chef_log bt-up "$*"; echo "bt-up: $*"; }

fail() { log "$*"; sleep 5; exit 1; }

# alive PID: a process that can still run; a zombie (an orphan that init,
# which reaps once a second, has not reaped yet) holds nothing.
alive() {
    st=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    st=${st##*) }
    [ -n "$st" ] && [ "${st%% *}" != Z ]
}

# Every live btattach: TERM, up to 2 s, then KILL.
stop_old_btattach() {
    old=
    for p in $(pidof btattach 2>/dev/null); do
        ! alive "$p" || old="$old $p"
    done
    [ -n "$old" ] || return 0
    kill -TERM $old 2>/dev/null
    i=0
    while [ "$i" -lt 20 ]; do
        left=
        for p in $old; do ! alive "$p" || left="$left $p"; done
        [ -n "$left" ] || break
        sleep 0.1; i=$((i+1))
    done
    if [ -n "$left" ]; then
        kill -KILL $left 2>/dev/null
        i=0
        while [ "$i" -lt 10 ]; do
            gone=1
            for p in $left; do ! alive "$p" || gone=; done
            [ -z "$gone" ] || break
            sleep 0.1; i=$((i+1))
        done
        log "stopped btattach${old} left by an earlier bt-up (KILL after 2 s:${left})"
    else
        log "stopped btattach${old} left by an earlier bt-up"
    fi
}

stop_old_btattach
[ -c "$BTPOWER" ] || fail "missing $BTPOWER"
[ -c "$UART" ] || fail "missing $UART"

if [ -e "$POWERED" ]; then
    # A previous attach left the firmware running (btattach died or was
    # restarted).  The rails are shared with Wi-Fi and cutting them does not
    # reliably reset the chip, and a running firmware ignores the power
    # pulses; so do what mainline's qca_power_off does: wake it over IBS
    # and send the vendor pre-shutdown command, then pulse.  The bytes are
    # harmless if the chip is in fact sitting in its ROM at 115200.
    log "shutting down the running WCN3990 firmware"
    btprobe baud "$UART" 3200000 1
    btprobe write "$UART" fd; sleep 0.05
    btprobe write "$UART" fd; sleep 0.05
    btprobe write "$UART" 0108fc00; sleep 0.05
else
    log "enabling WCN3990 power rails"
    btprobe power 1 || fail "btpower failed"
    touch "$POWERED"
fi

# The external circuit on TX decodes these single-byte pulses: c0 = BT core
# off, fc = on (boots the ROM); hardware flow control must be off while they
# go out (mainline hci_qca does the same).
stty -F "$UART" 2400 raw -echo -crtscts
btprobe write "$UART" c0
sleep 0.02
stty -F "$UART" 115200 raw -echo -crtscts
btprobe write "$UART" fc
sleep 0.15

# btattach reopens the UART, which resynchronises RTS/CTS after the pulses,
# sets 115200 with flow control and binds the N_HCI ldisc with proto qca.
log "attaching $UART as hci_uart/qca"
btattach -B "$UART" -P qca -S 115200 &
BTATTACH=$!

# The NVM only has a placeholder BD address, so hci_qca registers the
# controller as unconfigured; program the one the bootloader passes on the
# cmdline, which configures it and lets bluetoothd take it from there.
ADDR=
for a in $(cat "$CMDLINE"); do
    case "$a" in androidboot.btmacaddr=*) ADDR="${a#*=}" ;; esac
done
if [ -n "$ADDR" ]; then
    i=0
    while [ ! -d /sys/class/bluetooth/hci0 ] && [ $i -lt 50 ]; do
        sleep 0.1; i=$((i+1))
    done
    # Rejected (status 11) while the initial setup still has the adapter
    # powered; retried until the controller sits unconfigured and takes it.
    # (btprobe rather than btmgmt: bt_shell quits on init's /dev/null stdin.)
    i=0
    while [ $i -lt 20 ]; do
        if btprobe bdaddr 0 "$ADDR" >/tmp/bdaddr.log 2>&1; then
            log "hci0 public address set to $ADDR"
            break
        fi
        sleep 0.5; i=$((i+1))
    done
    [ $i -lt 20 ] || log "failed to set the public address: $(cat /tmp/bdaddr.log)"
else
    log "no androidboot.btmacaddr on the cmdline; hci0 stays unconfigured"
fi

wait $BTATTACH
