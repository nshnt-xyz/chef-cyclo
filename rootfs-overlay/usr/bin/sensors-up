#!/bin/sh
# The on-board sensors' two setup steps (tools/sensord/ and
# docs/features/sensors.md), each run by an OpenRC service:
#
#   sensors-up registry   the sensord service's start_pre: copy the sensors
#                         registry (sns.reg) out of the persist partition
#                         into RAM (or reuse this boot's copy), then irsc;
#                         sensord then serves the copy to the ADSP as QMI
#                         REG2 and is the SMGR client behind
#                         /run/chef/sensord/sensord.sock
#   sensors-up adsp       the sensors-up service (one-shot, after sensord):
#                         boot the ADSP through audio-up unless it is
#                         ONLINE or audio-up is running. The ADSP's sensor
#                         manager (QMI service 0x100) is not waited for:
#                         sensord polls for it.
#
# persist is device-unique and irreplaceable (factory calibration, the
# registry itself). Before mounting it, this script marks the block
# device itself read-only (blockdev --setro) and refuses to go on unless
# --getro reads back 1: a mount -o ro,noload alone is not enough, because
# ext4 still runs orphan cleanup on a read-only mount and writes the
# device if the superblock has an orphan list (kernel/fs/ext4/super.c
# ext4_orphan_cleanup(): it only skips when bdev_read_only()). The flag is
# never cleared; nothing on this image writes persist. Then it mounts
# ro,noload (noload is still needed: a read-only device with a journal to
# replay fails to mount without it), copies the one file, and unmounts
# before doing anything else. If persist is already mounted somewhere, it
# copies from there and leaves that mount alone. Its own files (the mount
# point, the copy as read, the boot id, the staging copy) are in root's
# /run/chef/sensors; sensord gets its working copy in its own
# /run/chef/sensord, built here and moved in (mv -fT: root never writes
# through a path in a daemon's directory), and writes the DSP's registry
# writes back to that copy only (never to persist). A later `sensors-up
# registry` in the same boot (boot id recorded in /run/chef/sensors, size
# matching the map) reuses that copy without touching persist at all, so the
# DSP's registry writes (the magnetometer hard-iron bias) stay available for
# an ADSP restart or re-read (the ADSP itself keeps its state across a sensord
# restart); a new boot, a size mismatch or SENSORS_FRESH=1 makes a fresh copy
# as above.
#
# Across boots only the magnetometer's group 2980 (the hard-iron bias the
# ADSP learns) is kept, by chef-state on /data, never the whole registry:
# after sensord writes the /run copy back (sensord runs `chef-state
# mag-save`, at most once a minute) and at shutdown (chef-state shutdown),
# that group is saved if its bias is nonzero; a fresh
# copy from persist gets the saved group overlaid (`chef-state
# mag-restore`) before sensord serves it, if it was learned against the
# same persist registry and map. SENSORS_FRESH=1 skips the overlay.
#
# Order: sensord's REG2 server is published *before* the ADSP boots, the
# way stock's sensors.qti (class core) is up before the sensor PD reads
# its configuration (the sensord service waits for REG2 in start_post, and
# the sensors-up service needs sensord). If the ADSP is already up
# (audio-up ran first), the registry comes late; sensord does not mind.
# audio-up is reused unchanged for the ADSP boot and started detached
# (setsid): it stays up as long as it needs to, whatever happens to the
# services. Both steps can be run by hand when the services are stopped.
#
# One instance only: an flock on /run/chef/lock/sensors-up.lock (fd 9, never
# passed to children), which the kernel drops with the process.
set -u

LOCK=${LOCK:-/run/chef/lock/sensors-up.lock}
PERSIST_MOUNTED=0

# Overridable for tools/sensord/tests/test_sensors-up.sh; unset in
# production.
SYSFS_BLOCK=${SYSFS_BLOCK:-/sys/block/mmcblk0}
PROC_MOUNTS=${PROC_MOUNTS:-/proc/mounts}
DUMP_SERVERS=${DUMP_SERVERS:-/sys/kernel/debug/msm_ipc_router/dump_servers}
SUBSYS_DIR=${SUBSYS_DIR:-/sys/bus/msm_subsys/devices}
RUN_DIR=${RUN_DIR:-/run/chef/sensors}		# root's: this script's files
SENSORD_DIR=${SENSORD_DIR:-/run/chef/sensord}	# sensord's: its working copy
PERSIST_MNT=${PERSIST_MNT:-$RUN_DIR/persist-ro}
PERSIST_FSTYPE=${PERSIST_FSTYPE:-ext4}
REG_PATH_IN_PERSIST=${REG_PATH_IN_PERSIST:-sensors/sns.reg}
REG_MAP=${REG_MAP:-/usr/share/sensord/sns_reg.map}
AUDIO_UP=${AUDIO_UP:-audio-up}
AUDIO_LOCK=${AUDIO_LOCK:-/run/chef/lock/audio-up.lock}
BOOT_ID_FILE=${BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}
SENSORS_FRESH=${SENSORS_FRESH:-0}
CHEF_STATE=${CHEF_STATE:-chef-state}
REG_COPY="$SENSORD_DIR/sns.reg"	# the working copy sensord serves
REG_TMP="$RUN_DIR/sns.reg.tmp"	# where the next working copy is built
REG_BOOT="$RUN_DIR/sns.reg.boot_id"	# the boot the copy was made in
REG_PRISTINE="$RUN_DIR/sns.reg.persist"	# the copy as read from persist

# part, server_present and find_subsys
. "${CHEF_LIB_DIR:-/usr/lib/chef}/sys.sh"

adsp_online() {
	s=$(find_subsys adsp) || return 1
	[ "$(cat "$s/state" 2>/dev/null)" = ONLINE ]
}

# Where persist is mounted already (first match in /proc/mounts), if at all.
persist_mountpoint() {
	awk -v dev="/dev/$1" '$1 == dev { print $2; exit }' "$PROC_MOUNTS" 2>/dev/null
}

# Byte size the registry map expects ("size N" line).
map_size() {
	awk '$1 == "size" { print $2; exit }' "$REG_MAP" 2>/dev/null
}

file_size() {
	wc -c < "$1" 2>/dev/null | tr -d ' '
}

# Copy sns.reg from persist to $REG_COPY. persist is only ever mounted
# read-only, noload, and unmounted before this returns. The copy is built
# in $RUN_DIR, then given to sensord and renamed over its working copy
# (rename replaces whatever is there, a planted link included; -T refuses
# a directory).
copy_registry() {
	persist=$(part persist)
	[ -n "$persist" ] || { log "persist partition not found"; return 1; }
	want=$(map_size)
	[ -n "$want" ] || { log "registry map $REG_MAP missing or has no size line"; return 1; }
	mkdir -p "$RUN_DIR"
	rm -f "$REG_TMP"
	src_mnt=$(persist_mountpoint "$persist")
	if [ -n "$src_mnt" ]; then
		log "persist already mounted at $src_mnt; copying from there, leaving it mounted"
		cp "$src_mnt/$REG_PATH_IN_PERSIST" "$REG_TMP" || { log "copy from $src_mnt failed"; return 1; }
	else
		blockdev --setro "/dev/$persist" || { log "blockdev --setro /dev/$persist failed; not mounting"; return 1; }
		ro=$(blockdev --getro "/dev/$persist" 2>/dev/null)
		if [ "$ro" != 1 ]; then
			log "/dev/$persist is not read-only after setro (getro=${ro:-?}); not mounting"
			return 1
		fi
		log "/dev/$persist set read-only at the block layer (blockdev --getro = 1)"
		mkdir -p "$PERSIST_MNT"
		mount -t "$PERSIST_FSTYPE" -o ro,noload "/dev/$persist" "$PERSIST_MNT" || {
			log "read-only mount of /dev/$persist failed"
			return 1
		}
		PERSIST_MOUNTED=1
		cp "$PERSIST_MNT/$REG_PATH_IN_PERSIST" "$REG_TMP"
		rc=$?
		umount "$PERSIST_MNT" && PERSIST_MOUNTED=0
		if [ "$PERSIST_MOUNTED" -ne 0 ]; then
			log "could not unmount persist from $PERSIST_MNT; refusing to continue"
			return 1
		fi
		rmdir "$PERSIST_MNT" 2>/dev/null
		[ "$rc" -eq 0 ] || { log "copy of $REG_PATH_IN_PERSIST from persist failed"; return 1; }
	fi
	got=$(file_size "$REG_TMP")
	if [ "$got" != "$want" ]; then
		log "sns.reg is ${got:-?} bytes, the map expects $want; not starting sensord"
		rm -f "$REG_TMP"
		return 1
	fi
	rm -f "$REG_PRISTINE" "$REG_BOOT"
	# 0444: chef-state's bias saves, run as sensord, compare against it
	cp "$REG_TMP" "$REG_PRISTINE" && chmod 0444 "$REG_PRISTINE"
	if [ "$SENSORS_FRESH" = 1 ]; then
		log "SENSORS_FRESH=1: no saved magnetometer bias applied"
	else
		if ! chef_state mag-restore "$REG_TMP"; then
			# never serve a half-written overlay: back to persist's bytes
			log "saved magnetometer bias not applied"
			cp "$REG_PRISTINE" "$REG_TMP" || { log "cannot restore the persist copy"; rm -f "$REG_TMP"; return 1; }
		fi
	fi
	if ! { chown sensord:sensord "$REG_TMP" && chmod 0600 "$REG_TMP" && mv -fT "$REG_TMP" "$REG_COPY"; }; then
		log "cannot hand the registry copy to sensord ($REG_COPY)"
		rm -f "$REG_TMP"
		return 1
	fi
	cat "$BOOT_ID_FILE" > "$REG_BOOT" 2>/dev/null
	log "registry copied to $REG_COPY ($got bytes; persist untouched)"
}

# Reuse the working copy an earlier sensord of this boot left behind, with
# what the DSP wrote into it (sensord writes its RAM registry back there:
# live, the magnetometer bias the DSP learned). Only when it was made in
# this boot (boot id recorded in $RUN_DIR) and has the map's size; persist
# is not touched at all then (no setro, no mount). The copy is sensord's:
# looked at without following a link (lstat, busybox stat's default).
# SENSORS_FRESH=1 removes it and forces a fresh copy. 1 = make a fresh copy.
reuse_registry() {
	if [ "$SENSORS_FRESH" = 1 ]; then
		rm -f "$REG_COPY"
		log "SENSORS_FRESH=1: fresh registry copy from persist"
		return 1
	fi
	[ ! -h "$REG_COPY" ] && [ -f "$REG_COPY" ] || return 1
	bid=$(cat "$BOOT_ID_FILE" 2>/dev/null)
	if [ -z "$bid" ] || [ "$(cat "$REG_BOOT" 2>/dev/null)" != "$bid" ]; then
		log "registry copy $REG_COPY is not from this boot; fresh copy from persist"
		return 1
	fi
	want=$(map_size)
	got=$(stat -c %s "$REG_COPY" 2>/dev/null)
	if [ -z "$want" ] || [ "$got" != "$want" ]; then
		log "registry copy is ${got:-?} bytes, the map expects ${want:-?}; fresh copy from persist"
		return 1
	fi
	if [ -f "$REG_PRISTINE" ]; then
		kept="$(cmp -l "$REG_PRISTINE" "$REG_COPY" 2>/dev/null | wc -l | tr -d ' ') bytes differ from persist's"
	else
		kept="no persist copy to compare"
	fi
	log "registry reused from this boot: $REG_COPY ($got bytes, DSP writes kept: $kept; persist not touched)"
	return 0
}

# chef-state on this script's registry paths (overridable for the tests).
chef_state() {
	CHEF_STATE_SENSORS_PRISTINE="$REG_PRISTINE" CHEF_STATE_MAP="$REG_MAP" "$CHEF_STATE" "$@"
}

# syslog through the shared helper (kmsg while syslogd is not up), and
# stdout for the log file the service or the caller keeps
. "${CHEF_LIB_DIR:-/usr/lib/chef}/log.sh"
log() {
	chef_log sensors-up "$*"
	echo "sensors-up: $*"
}

cleanup() {
	status=$?
	trap - EXIT HUP INT TERM
	# Only reachable between mount and umount if cp itself was killed.
	[ "$PERSIST_MOUNTED" -eq 1 ] && umount "$PERSIST_MNT" 2>/dev/null
	rm -f "$REG_TMP"
	exit "$status"
}

[ "${SENSORS_UP_SELFTEST:-0}" = 1 ] && return 0 2>/dev/null

case "${1:-}" in
registry|adsp) ;;
*) echo "usage: sensors-up registry|adsp" >&2; exit 2 ;;
esac
exec 9>"$LOCK" || { log "cannot open $LOCK"; exit 1; }
if ! flock -n 9; then
	log "already running ($LOCK is locked)"
	exit 1
fi
trap cleanup EXIT HUP INT TERM

if [ "$1" = registry ]; then
	# debugfs: the sensord service's start_post reads dump_servers too
	mkdir -p /sys/kernel/debug
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	[ -r "$DUMP_SERVERS" ] || { log "IPC-router debugfs dump_servers is unavailable"; exit 1; }
	reuse_registry || copy_registry || exit 1
	if ! irsc; then
		log "irsc failed; refusing to start clients that could block in IPC router security"
		exit 1
	fi
	exit 0
fi

if adsp_online; then
	log "adsp already ONLINE; its sensor PD read (or will read) the registry late"
elif [ -d "$AUDIO_LOCK" ]; then
	log "audio-up is running; it brings the adsp up"
else
	setsid "$AUDIO_UP" </dev/null 9>&- &
	log "started $AUDIO_UP (pid $!) to boot the adsp; sensord polls for SMGR (0x100)"
fi
