#!/bin/sh
# Small state that outlives a reboot, on the /data layout (chef-storage):
# crash records and a boot history, the wall clock against the RTC, and the
# magnetometer bias the ADSP learns. See docs/features/storage.md
# ("Persistent state") and docs/archive/state-persistence-handoff.md.
#
#   chef-state ours          exit 0 if /data is our mounted layout (silent)
#   chef-state boot          /init: restore the clock, save pstore records,
#                            append the boot history
#   chef-state timekeeper    the chef-timekeeper service: save the RTC
#                            offset while chrony is
#                            synchronised (60 s until the first save of the
#                            boot, then every 15 min; rewrites are skipped
#                            unless the offset moved or 6 h passed)
#   chef-state time-save     one RTC offset save (needs chrony synchronised)
#   chef-state mag-save      sensord: group 2980 from the RAM registry copy
#   chef-state mag-restore F sensors-up registry: overlay the saved group
#                            2980 onto F,
#                            a fresh registry copy from persist
#   chef-state gps-load      gps-manager: print "enabled 0|1" (the GPS
#                            switch; 1 when nothing valid is saved)
#   chef-state gps-save 0|1  gps-manager: save the GPS switch
#   chef-state blesens-load  blesensd: print the saved BLE sensor records
#                            (nothing when none or invalid)
#   chef-state blesens-save  blesensd: save the records on stdin
#   chef-state shutdown [poweroff|reboot]
#                            inittab, before chef-storage shutdown. First
#                            of all it writes /run/chef/shutting-down (the
#                            reason, one line; the first writer wins), which
#                            puts up chef-settings' shutdown screen. Then:
#                            last
#                            offset save, stop chronyd (it writes its drift
#                            file on exit), powerd (it flushes its pending
#                            power log rows on exit; rows a stopped powerd
#                            left are flushed here), sensord (it writes the
#                            registry copy back on exit) and the timekeeper
#                            through OpenRC, last bias save; the flush and
#                            the bias save run as powerd and sensord (root
#                            never writes into a daemon's directories).
#                            Without an argument the reason is poweroff
#                            when powerd's shutdown-pending or buttond's
#                            poweroff hint exists, else unknown
#   chef-state log-save      inittab after shutdown, and chef-reboot: this
#                            boot's syslogd ring (logread) into
#                            /data/v1/log/syslog-<seq>, the newest 8 kept
#
# Nothing is read from or written to /data unless `ours` holds (mounted
# /data with the chef-layout marker); otherwise every consumer runs from
# /run as before. Saved files are text with a trailing sha256 line, written
# as a temp file in the same directory, fsynced, renamed, and the directory
# fsynced, under a lock per kind in /run/chef/state: the kinds run for a
# daemon (mag for sensord, gps for gps-manager, blesens for blesensd) have
# their lock and RAM files in a directory of their own there, which the
# daemon's service makes and owns; chef-state never creates those, and
# without one that kind's saves fail with a log line. A torn or invalid file
# is ignored with a log line, never trusted, never fatal. boots.log is
# appended (one line per boot, fsynced) and its parser skips a torn line.
# This script never changes directory into /data and never keeps a
# descriptor there, so chef-storage shutdown's fuser never finds it. No
# `set -e`: /init runs it before init and a failure must only cost the
# state, never the boot.
DATA=${CHEF_STATE_DATA:-/data}
RUN=${CHEF_STATE_RUN:-/run/chef}
ST=$RUN/state	# this script's own files on /run
KMSG=${CHEF_STATE_KMSG:-/dev/kmsg}
CMDLINE=${CHEF_STATE_CMDLINE:-/proc/cmdline}
BOOT_ID_FILE=${CHEF_STATE_BOOT_ID:-/proc/sys/kernel/random/boot_id}
RTC=${CHEF_STATE_RTC:-/sys/class/rtc/rtc0}
PSTORE=${CHEF_STATE_PSTORE:-/sys/fs/pstore}
CHRONY_SOCK=${CHEF_STATE_CHRONY_SOCK:-/run/chrony/chronyd.sock}
SNS_RUN=${CHEF_STATE_SENSORS_RUN:-$RUN/sensord}	# sensord's working copy sns.reg
SNS_PRISTINE=${CHEF_STATE_SENSORS_PRISTINE:-$RUN/sensors/sns.reg.persist}	# as read from persist
SU=${CHEF_STATE_SU:-su}		# busybox su: the shutdown runs a daemon's work as that daemon
MAP=${CHEF_STATE_MAP:-/usr/share/sensord/sns_reg.map}
SHUTTING_DOWN=${CHEF_STATE_SHUTTING_DOWN:-$RUN/shutting-down}	# public: the shutdown screen's trigger and reason
POWER_PENDING=${CHEF_STATE_POWER_PENDING:-$RUN/power/shutdown-pending}	# powerd, just before its power-off
BUTTOND_HINT=${CHEF_STATE_BUTTOND_HINT:-$RUN/buttond/poweroff}	# buttond, just before its power-off
PROC=${CHEF_STATE_PROC:-/proc}
RC_OPTIONS=${CHEF_STATE_RC_OPTIONS:-/run/openrc/options}	# supervise-daemon's child_pid per service
MARKER=chef-cyclo-data-v1
TIME_FILE=$DATA/v1/time/rtc-offset
CRASH=$DATA/v1/crash
LOGDIR=$DATA/v1/log
MAG_FILE=$DATA/v1/sensors/mag-group-2980
GPS_FILE=$DATA/v1/gps/enabled
GPS_RUN_FILE=$ST/gps/enabled	# when /data is not ours (lost at reboot)
BLESENS_FILE=$DATA/v1/blesens/sensors
BLESENS_RUN_FILE=$ST/blesens/sensors	# when /data is not ours (lost at reboot)
BLESENS_MAX=8
MAG_GROUP=2980
MAG_BIAS_ITEM=3903		# 3903..3905: x y z, int32 LE, Q16 gauss
MAG_BIAS_MAX=131072		# 2 G
WALL_MIN=1767225600		# 2026-01-01T00:00:00Z
WALL_MAX=4102444800		# 2100-01-01T00:00:00Z
SPAN_MAX=157680000		# 5 years of RTC seconds between save and restore
POWER_LOG_MAX=4194304		# powerd -L in init.d/powerd (a host test checks they agree)
CRASH_KEEP=32
CRASH_MAX_KB=16384
BOOTS_MAX=262144
LOG_KEEP=8
LOG_MAX_KB=8192

# Lines go to syslog through the shared helper, or to $KMSG: `boot` runs
# from /init before syslogd exists, and `shutdown` forces kmsg (below).
CHEF_LOG_KMSG=$KMSG
. "${CHEF_LIB_DIR:-/usr/lib/chef}/log.sh"
log() {
	echo "chef-state: $*" >&2 || true
	chef_log chef-state "$*"
}

ours() {
	mountpoint -q "$DATA" 2>/dev/null || return 1
	[ "$(cat "$DATA/chef-layout" 2>/dev/null)" = "$MARKER" ]
}

# Canonical decimal within a conservative signed int64 range. Shell
# arithmetic treats leading zero as octal; reject it before any arithmetic.
isint() {
	v=${1#-}
	case "$v" in ''|*[!0-9]*|0?*) return 1;; esac
	[ "${#v}" -le 19 ] || return 1
	[ "${#v}" -lt 19 ] || case "$v" in [0-8]*) return 0;; *) return 1;; esac
}

isrtc() { isint "$1" && [ "$1" -gt 0 ] && [ "$1" -le 4294967295 ]; }

boot_id() {
	b=$(cat "$BOOT_ID_FILE" 2>/dev/null)
	case "$b" in
	[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) echo "$b";;
	*) echo unknown;;
	esac
}

since_now() {
	s=$(cat "$RTC/since_epoch" 2>/dev/null)
	isrtc "$s" && echo "$s"
}

bootreason() {
	r=
	for arg in $(cat "$CMDLINE" 2>/dev/null); do
		case "$arg" in androidboot.bootreason=*) r=${arg#*=};; esac
	done
	r=$(printf '%s' "$r" | tr -c 'A-Za-z0-9_' '_' | cut -c1-32)
	echo "${r:-unknown}"
}

sha() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }

# stdin -> body with a trailing "sha256 <hex of the body>" line.
seal() {
	body=$(cat)
	printf '%s\nsha256 %s\n' "$body" "$(printf '%s\n' "$body" | sha256sum | cut -d' ' -f1)"
}

# Print the body of sealed FILE. 2: missing, 1: invalid (reason on stderr).
unseal() {
	[ -e "$1" ] || return 2
	[ -f "$1" ] || { echo "not a regular file" >&2; return 1; }
	size=$(wc -c < "$1" 2>/dev/null)
	[ -n "$size" ] && [ "$size" -le 4096 ] || { echo "size ${size:-?}" >&2; return 1; }
	[ "$(tr -d '\000' < "$1" | wc -c)" = "$size" ] || { echo "NUL bytes" >&2; return 1; }
	[ "$(tail -c 1 "$1" | wc -l)" = 1 ] || { echo "no final newline" >&2; return 1; }
	last=$(tail -n 1 "$1")
	body=$(sed '$d' "$1")
	case "$last" in "sha256 "*) ;; *) echo "no checksum line" >&2; return 1;; esac
	[ "${last#sha256 }" = "$(printf '%s\n' "$body" | sha256sum | cut -d' ' -f1)" ] ||
		{ echo "checksum mismatch" >&2; return 1; }
	printf '%s\n' "$body"
}

# stdin -> FILE atomically. The caller holds the kind's lock.
put() {
	tmp="$1.tmp.$$"
	if cat > "$tmp" && sync "$tmp" && mv -f "$tmp" "$1" && sync "${1%/*}"; then
		return 0
	fi
	rm -f "$tmp"
	return 1
}

# Run "$@" holding the lock for kind $1 (in $ST, never /data): $ST/KIND.lock,
# or $ST/KIND/lock for a daemon's kind, whose directory must exist (1 and a
# log line otherwise). Stale temp files of that kind are only removed under
# the lock. With LOCK_TRIES set, give up with 75 after that many 0.1 s
# retries instead of queueing behind the holder (BusyBox flock has no -w).
# Commands that may outlive the holder (BusyBox timeout's watchdog daemon)
# get 8>&- so they never pin it.
locked() {
	kind=$1; shift
	case $kind in
	mag|gps|blesens)
		[ -d "$ST/$kind" ] || { log "$kind: no $ST/$kind (its service makes it); not saved"; return 1; }
		lock=$ST/$kind/lock;;
	*) lock=$ST/$kind.lock;;
	esac
	(
		if [ -n "${LOCK_TRIES:-}" ]; then
			tries=$LOCK_TRIES
			until flock -n 8; do
				[ "$tries" -gt 0 ] || exit 75
				sleep 0.1
				tries=$((tries - 1))
			done
		else
			flock 8 || exit 1
		fi
		"$@"
	) 8>"$lock"
}

# ---------------------------------------------------------------- clock

# Load and check the saved offset: T_OFFSET T_SINCE T_WALL T_BOOT.
# 0: valid, 2: missing, 1: invalid (logged unless $1 = quiet).
time_load() {
	quiet=${1:-}
	body=$(unseal "$TIME_FILE" 2>/dev/null); rc=$?
	[ "$rc" != 1 ] || why=$(unseal "$TIME_FILE" 2>&1 >/dev/null)
	[ "$rc" = 2 ] && return 2
	if [ "$rc" = 0 ]; then
		# shellcheck disable=SC2086 # word split on purpose
		set -- $body
		if [ "$#" != 10 ] || [ "$1 $2" != "chef-rtc-offset 1" ] || [ "$3" != offset_ns ] ||
		   [ "$5" != since_epoch ] || [ "$7" != wall_s ] || [ "$9" != boot_id ]; then
			why="unknown format or version"
		elif ! isint "$4" || ! isint "$6" || ! isint "$8"; then
			why="non-numeric field"
		elif ! isrtc "$6" || [ "$8" -lt "$WALL_MIN" ] || [ "$8" -ge "$WALL_MAX" ]; then
			why="out of range"
		else
			d=$(($8 - $6 - $4 / 1000000000))
			if [ "$d" -lt -2 ] || [ "$d" -gt 2 ]; then
				why="offset and wall time disagree"
			else
				T_OFFSET=$4 T_SINCE=$6 T_WALL=$8 T_BOOT=${10}
				return 0
			fi
		fi
	fi
	[ "$quiet" = quiet ] || log "time: ignoring $TIME_FILE: $why"
	return 1
}

# chronyd synchronised to a real source: leap status Normal and a
# reference that is neither none nor its local clock. The GPS SHM refclock
# counts.
synced() {
	out=$(timeout -k 1 "${CHRONYC_SECS:-3}" chronyc -h "$CHRONY_SOCK" -n tracking 2>/dev/null 8>&-) || return 1
	leap=$(printf '%s\n' "$out" | sed -n 's/^Leap status *: *//p')
	ref=$(printf '%s\n' "$out" | sed -n 's/^Reference ID *: *\([0-9A-Fa-f]*\).*/\1/p')
	name=$(printf '%s\n' "$out" | sed -n 's/^Reference ID *: *[0-9A-Fa-f]* *(\(.*\)).*/\1/p')
	[ "$leap" = Normal ] || return 1
	case "$ref" in ''|00000000|7F7F0101|7f7f0101) return 1;; esac
	[ "$name" != LOCL ]
}

# 0: saved or unchanged, 1: not saved (not ours, not synced, no edge).
time_save_locked() {
	rm -f "$TIME_FILE".tmp.*
	synced || return 1
	out=$(timeout -k 1 "${EDGE_SECS:-3}" rtc-edge -r "$RTC" sample 8>&-) || { log "time: no RTC tick; offset not saved"; return 1; }
	# shellcheck disable=SC2086
	set -- $out
	if [ "$#" != 2 ] || ! isrtc "$1" || ! isint "$2" || [ "$2" -lt 1767225600000000000 ] || [ "$2" -ge 4102444800000000000 ]; then
		log "time: bad rtc-edge output; offset not saved"; return 1
	fi
	since=$1 offset=$(($2 - $1 * 1000000000)) wall=$(($2 / 1000000000))
	if [ "$wall" -lt "$WALL_MIN" ] || [ "$wall" -ge "$WALL_MAX" ]; then
		log "time: wall clock $wall out of range; offset not saved"; return 1
	fi
	if time_load quiet; then
		d=$((offset - T_OFFSET)); [ "$d" -ge 0 ] || d=$((-d))
		age=$((since - T_SINCE))
		[ "$d" -ge 100000000 ] || [ "$age" -lt 0 ] || [ "$age" -ge 21600 ] || return 0
	fi
	mkdir -p "${TIME_FILE%/*}" && chmod 700 "${TIME_FILE%/*}" || return 1
	printf 'chef-rtc-offset 1\noffset_ns %s\nsince_epoch %s\nwall_s %s\nboot_id %s\n' \
		"$offset" "$since" "$wall" "$(boot_id)" | seal | put "$TIME_FILE" ||
		{ log "time: writing $TIME_FILE failed"; return 1; }
	log "time: saved RTC offset $offset ns at since_epoch $since"
}

time_save() {
	ours || return 1
	locked time time_save_locked
	rc=$?
	[ "$rc" != 75 ] || { log "time: save lock still busy; offset save skipped"; return 1; }
	return "$rc"
}

# Write /run/chef/state/time: source=rtc-offset|floor|none, reason, saved_age_s.
time_status() {
	printf 'source=%s\nreason=%s\nsaved_age_s=%s\n' "$1" "$2" "$3" > "$ST/time.tmp" &&
		mv -f "$ST/time.tmp" "$ST/time"
	if [ "$1" = rtc-offset ]; then
		log "time: clock set from the saved RTC offset (saved $3 s ago by the RTC)"
	else
		log "time: clock source $1 ($2)"
	fi
}

time_restore() {
	if ! ours; then time_status none ram-only na; return; fi
	time_load; rc=$?
	[ "$rc" = 2 ] && { time_status none missing na; return; }
	[ "$rc" = 0 ] || { time_status none invalid na; return; }
	now=$(since_now) || { time_status none no-rtc na; return; }
	age=$((now - T_SINCE)) why=
	if [ "$age" -lt 0 ]; then
		why=rtc-reset
	elif [ "$age" -gt "$SPAN_MAX" ]; then
		why=span
	else
		target=$((now + T_OFFSET / 1000000000))
		if [ "$target" -lt "$WALL_MIN" ] || [ "$target" -ge "$WALL_MAX" ]; then
			why=range
		elif timeout -k 1 3 rtc-edge -r "$RTC" set "$T_OFFSET" >/dev/null; then
			time_status rtc-offset ok "$age"; return
		else
			why=no-tick
		fi
	fi
	timeout -k 1 3 rtc-edge floor "$T_WALL" >/dev/null; rc=$?
	case "$rc" in
	0) time_status floor "$why" na;;
	4) time_status none "$why-clock-ahead" na;;
	*) time_status none "$why-set-failed" na;;
	esac
}

timekeeper() {
	cd / || exit 1
	said=
	while :; do
		if ! ours; then
			[ -n "$said" ] || log "time: /data is not ours; RTC offset not saved"
			said=1
			sleep 3600
		elif time_save; then
			sleep 900
		else
			sleep 60
		fi
	done
}

# ---------------------------------------------------------------- crash

# A boots.log line: exactly these six fields.
BOOT_LINE='^seq=[1-9][0-9]{0,8} boot_id=([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|unknown) bootreason=[A-Za-z0-9_]{1,32} since_epoch=[0-9]{1,12} wall=([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|na) pstore=[0-9]{1,4}$'

# The last parseable line with the highest seq, from boots.log(.1).
last_boot() {
	cat "$CRASH/boots.log.1" "$CRASH/boots.log" 2>/dev/null | tr '\000' '#' |
		grep -E "$BOOT_LINE" | sed "s/^seq=//" | sort -n | tail -n 1 | sed "s/^/seq=/"
}

boots_append() {
	f=$CRASH/boots.log
	size=0
	[ ! -f "$f" ] || size=$(wc -c < "$f")
	if [ "$size" -ge "$BOOTS_MAX" ]; then
		mv -f "$f" "$f.1" && sync "$CRASH" || { log "crash: boots.log rotation failed"; return 1; }
	elif [ "$size" -gt 0 ] && [ "$(tail -c 1 "$f" | wc -l)" != 1 ]; then
		echo >> "$f"
	fi
	echo "$1" >> "$f" && sync "$f" && sync "$CRASH"
}

crash_prune() {
	dirs=$(ls -1 "$CRASH" 2>/dev/null | grep -E '^[1-9][0-9]{0,8}-' | sort -n)
	n=$(printf '%s\n' "$dirs" | grep -c .)
	for d in $dirs; do
		kb=$(du -sk "$CRASH" 2>/dev/null | cut -f1)
		[ "$n" -gt "$CRASH_KEEP" ] || { [ "$n" -gt 0 ] && [ "${kb:-0}" -gt "$CRASH_MAX_KB" ]; } || break
		rm -rf "${CRASH:?}/$d" && n=$((n - 1)) && log "crash: removed old record $d"
	done
	sync "$CRASH"
}

# Copy pstore's records (if any) into $CRASH/<seq>-<bootreason>/; records
# already saved (same sha256) are skipped. pstore is mounted read-only and
# nothing in it is removed: the next boot clears it.
crash_collect() {
	seq=$1 reason=$2 prev=$3 wall=$4 since=$5
	PSTORE_FILES=0
	mounted=
	if ! mountpoint -q "$PSTORE" 2>/dev/null; then
		timeout -k 1 5 mount -t pstore -o ro pstore "$PSTORE" 2>/dev/null ||
			{ log "crash: cannot mount pstore on $PSTORE"; return 1; }
		mounted=1
	fi
	tmp=$CRASH/.tmp-$seq
	rm -rf "$CRASH"/.tmp-*
	list=
	for f in "$PSTORE"/*; do
		# empty records (annotate-ramoops-0 on every boot) carry nothing
		[ -f "$f" ] && [ -s "$f" ] || continue
		PSTORE_FILES=$((PSTORE_FILES + 1))
		name=${f##*/} h=$(sha "$f") size=$(wc -c < "$f")
		[ -n "$h" ] || continue
		found=
		for info in "$CRASH"/[0-9]*/info; do
			[ -f "$info" ] || continue
			while read -r tag saved_name saved_size saved_hash extra; do
				[ "$tag" = file ] && [ "$saved_hash" = "$h" ] && [ -z "$extra" ] || continue
				case "$saved_name" in ''|*/*|.|..) continue;; esac
				[ "$(sha "${info%/*}/$saved_name")" = "$h" ] && found=1
			done < "$info"
		done
		[ -z "$found" ] || continue
		mkdir -p -m 700 "$tmp" && cp "$f" "$tmp/$name" || { log "crash: copying $name failed"; continue; }
		list="${list}file $name $size $h
"
	done
	[ -z "$mounted" ] || timeout -k 1 5 umount "$PSTORE" || log "crash: pstore unmount failed"
	[ -n "$list" ] || return 0
	dest=$CRASH/$seq-$reason
	{
		printf 'seq %s\nboot_id %s\nprevious_boot_id %s\nbootreason %s\nsince_epoch %s\nwall %s\n' \
			"$seq" "$(boot_id)" "$prev" "$reason" "$since" "$wall"
		printf '%s' "$list"
	} > "$tmp/info" && sync "$tmp"/* && sync "$tmp" && mv "$tmp" "$dest" && sync "$CRASH" ||
		{ log "crash: saving records failed"; rm -rf "$tmp"; return 1; }
	log "crash: saved previous boot's records to $dest ($(printf '%s' "$list" | grep -c .) files)"
}

crash_boot() {
	if ! ours; then log "crash: /data is not ours; pstore records and boot history not saved"; return; fi
	mkdir -p "$CRASH" && chmod 700 "$CRASH" || { log "crash: cannot create $CRASH"; return; }
	last=$(last_boot)
	seq=1 prev=none
	if [ -n "$last" ]; then
		# shellcheck disable=SC2086
		set -- $last
		seq=$((${1#seq=} + 1)) prev=${2#boot_id=}
	fi
	# never reuse a record directory's number (boots.log lost or torn)
	top=$(ls -1 "$CRASH" 2>/dev/null | sed -n 's/^\([1-9][0-9]\{0,8\}\)-.*/\1/p' | sort -n | tail -n 1)
	[ -z "$top" ] || [ "$top" -lt "$seq" ] || seq=$((top + 1))
	reason=$(bootreason) since=$(since_now || echo 0)
	wall=na
	case "$(sed -n 's/^source=//p' "$ST/time" 2>/dev/null)" in
	rtc-offset|floor) wall=$(date -u +%Y-%m-%dT%H:%M:%SZ);;
	esac
	crash_collect "$seq" "$reason" "$prev" "$wall" "$since"
	boots_append "seq=$seq boot_id=$(boot_id) bootreason=$reason since_epoch=$since wall=$wall pstore=${PSTORE_FILES:-0}" ||
		log "crash: appending to boots.log failed"
	crash_prune
}

# ---------------------------------------------------------------- magnetometer

# "OFFSET LENGTH" of group 2980 and the bias items' offsets inside it, from
# the map. Fails closed.
mag_map() {
	awk -v g="$MAG_GROUP" -v i="$MAG_BIAS_ITEM" '
		$1 == "size" { size = $2 }
		$1 == "group" && $2 == g { go = $3; gl = $4 }
		$1 == "item" && $2 >= i && $2 <= i + 2 { io[$2 - i] = $3; il[$2 - i] = $4 }
		END {
			if (go == "" || gl == "" || size == "" || go + gl > size) exit 1
			for (k = 0; k < 3; k++)
				if (il[k] != 4 || io[k] < go || io[k] + 4 > go + gl) exit 1
			print go, gl, size, io[0] - go, io[1] - go, io[2] - go
		}' "$MAP" 2>/dev/null
}

hexbytes() {
	dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | od -An -v -tx1 | tr -d ' \n'
}

# Signed little-endian int32 at byte offset $2 of hex string $1.
le32() {
	h=$(printf '%s' "$1" | cut -c$(($2 * 2 + 1))-$(($2 * 2 + 8)))
	[ "${#h}" = 8 ] || return 1
	v=$((0x$(printf '%s' "$h" | cut -c7-8)$(printf '%s' "$h" | cut -c5-6)$(printf '%s' "$h" | cut -c3-4)$(printf '%s' "$h" | cut -c1-2)))
	[ "$v" -lt 2147483648 ] || v=$((v - 4294967296))
	echo "$v"
}

# Bias of hex group $1 as "x y z" (raw Q16). 0: nonzero and plausible,
# 1: all zero, 2: out of range or unreadable.
mag_bias() {
	BIAS=
	for r in $MAG_REL; do
		v=$(le32 "$1" "$r") || return 2
		BIAS="$BIAS $v"
	done
	zero=1
	for v in $BIAS; do
		[ "$v" = 0 ] || zero=0
		[ "$v" -ge "-$MAG_BIAS_MAX" ] && [ "$v" -le "$MAG_BIAS_MAX" ] || return 2
	done
	[ "$zero" = 0 ] || return 1
}

gauss() { echo "$*" | awk '{ printf "%.4f %.4f %.4f", $1 / 65536, $2 / 65536, $3 / 65536 }'; }

# Map geometry into MAG_OFF MAG_LEN MAG_SIZE MAG_REL; 1 if unusable.
mag_geometry() {
	g=$(mag_map) || return 1
	# shellcheck disable=SC2086
	set -- $g
	MAG_OFF=$1 MAG_LEN=$2 MAG_SIZE=$3 MAG_REL="$4 $5 $6"
}

# Load the saved group: M_HEX, M_PSHA, M_MSHA. 0 valid, 2 missing, 1
# invalid (logged unless $1 = quiet). Needs mag_geometry.
mag_load() {
	quiet=${1:-}
	body=$(unseal "$MAG_FILE" 2>/dev/null); rc=$?
	[ "$rc" != 1 ] || why=$(unseal "$MAG_FILE" 2>&1 >/dev/null)
	[ "$rc" = 2 ] && return 2
	if [ "$rc" = 0 ]; then
		# shellcheck disable=SC2086
		set -- $body
		if [ "$#" != 12 ] || [ "$1 $2" != "chef-mag-group 1" ] || [ "$3 $4" != "group $MAG_GROUP" ] ||
		   [ "$5" != length ] || [ "$7" != persist_sha256 ] || [ "$9" != map_sha256 ] || [ "${11}" != bytes ]; then
			why="unknown format or version"
		elif [ "$6" != "$MAG_LEN" ] || [ "${#12}" != $((MAG_LEN * 2)) ]; then
			why="length differs from the map's group $MAG_GROUP"
		else
			case "${12}" in *[!0-9a-f]*) why="bad hex";; *)
				M_PSHA=$8 M_MSHA=${10} M_HEX=${12}
				return 0;;
			esac
		fi
	fi
	[ "$quiet" = quiet ] || log "mag: ignoring $MAG_FILE: $why"
	return 1
}

mag_save_locked() {
	read -r mag_now _ < "$PROC/uptime"
	mag_now=${mag_now%%.*}
	mag_last=$(cat "$ST/mag/last" 2>/dev/null)
	if [ "${CHEF_STATE_MAG_FINAL:-0}" != 1 ] && isint "$mag_now" && isint "$mag_last" &&
	   [ "$mag_now" -ge "$mag_last" ] && [ $((mag_now - mag_last)) -lt 60 ]; then
		return 3	# deferred: caller must retain pending snapshot
	fi
	rm -f "$MAG_FILE".tmp.*
	reg=$SNS_RUN/sns.reg pristine=$SNS_PRISTINE
	[ -f "$reg" ] && [ -f "$pristine" ] || return 0
	mag_geometry || { log "mag: group $MAG_GROUP not in $MAP; bias not saved"; return 1; }
	[ "$(wc -c < "$reg")" = "$MAG_SIZE" ] || { log "mag: $reg size differs from the map; bias not saved"; return 1; }
	hex=$(hexbytes "$reg" "$MAG_OFF" "$MAG_LEN")
	[ "${#hex}" = $((MAG_LEN * 2)) ] || { log "mag: cannot read group $MAG_GROUP; bias not saved"; return 1; }
	mag_bias "$hex"; rc=$?
	[ "$rc" = 1 ] && return 0	# nothing learned yet; never replaces a saved bias
	[ "$rc" = 0 ] || { log "mag: implausible bias$BIAS; not saved"; return 1; }
	psha=$(sha "$pristine") msha=$(sha "$MAP")
	[ -n "$psha" ] && [ -n "$msha" ] || return 1
	if mag_load quiet && [ "$M_HEX" = "$hex" ] && [ "$M_PSHA" = "$psha" ] && [ "$M_MSHA" = "$msha" ]; then
		return 0
	fi
	mkdir -p "${MAG_FILE%/*}" && chmod 700 "${MAG_FILE%/*}" || return 1
	printf 'chef-mag-group 1\ngroup %s\nlength %s\npersist_sha256 %s\nmap_sha256 %s\nbytes %s\n' \
		"$MAG_GROUP" "$MAG_LEN" "$psha" "$msha" "$hex" | seal | put "$MAG_FILE" ||
		{ log "mag: writing $MAG_FILE failed"; return 1; }
	printf '%s\n' "$mag_now" > "$ST/mag/last"
	log "mag: saved group $MAG_GROUP bias $(gauss $BIAS) gauss"
}

mag_save() {
	ours || return 0
	locked mag mag_save_locked
}

# Overlay the saved group onto $1 (a fresh copy of persist's sns.reg, not
# yet served). Only if the saved file is valid, was learned against the
# same persist registry (sns.reg.persist) and map, and its bias is
# plausible and nonzero. 0 also when nothing is applied; 1 only if the
# overlay itself failed, and then $1 is unchanged (the overlay goes into a
# scratch copy that replaces $1 only after its read-back matches).
mag_restore() {
	target=$1
	ours || { log "mag: /data is not ours; no saved bias applied"; return 0; }
	mag_geometry || { log "mag: group $MAG_GROUP not in $MAP; no saved bias applied"; return 0; }
	mag_load; rc=$?
	[ "$rc" = 2 ] && { log "mag: no saved bias"; return 0; }
	[ "$rc" = 0 ] || return 0
	[ "$M_PSHA" = "$(sha "$SNS_PRISTINE")" ] ||
		{ log "mag: saved bias was learned against another persist registry; not applied"; return 0; }
	[ "$M_MSHA" = "$(sha "$MAP")" ] || { log "mag: saved bias was saved with another map; not applied"; return 0; }
	[ -f "$target" ] && [ "$(wc -c < "$target")" = "$MAG_SIZE" ] || { log "mag: $target size differs from the map; not applied"; return 0; }
	mag_bias "$M_HEX" || { log "mag: saved bias zero or implausible; not applied"; return 0; }
	scratch="$target.mag.$$"
	if cp -p "$target" "$scratch" &&
	   printf '%s' "$M_HEX" | xxd -r -p | dd of="$scratch" bs=1 seek="$MAG_OFF" conv=notrunc 2>/dev/null &&
	   [ "$(hexbytes "$scratch" "$MAG_OFF" "$MAG_LEN")" = "$M_HEX" ] &&
	   [ "$(wc -c < "$scratch")" = "$MAG_SIZE" ] && mv -f "$scratch" "$target"; then
		:
	else
		rm -f "$scratch"
		log "mag: overlay onto $target failed; left as read from persist"
		return 1
	fi
	log "mag: seeded group $MAG_GROUP bias $(gauss $BIAS) gauss into $target"
}

# ---------------------------------------------------------------- GPS switch

# The GPS switch gps-manager serves: /data/v1/gps/enabled when /data is
# ours, else a file on /run with the same format. "chef-gps 1" and
# "enabled 0|1", sealed. Missing or invalid (logged): enabled.
gps_file() {
	if ours; then echo "$GPS_FILE"; else echo "$GPS_RUN_FILE"; fi
}

gps_load() {
	f=$(gps_file)
	body=$(unseal "$f" 2>/dev/null); rc=$?
	[ "$rc" != 1 ] || why=$(unseal "$f" 2>&1 >/dev/null)
	if [ "$rc" = 0 ]; then
		# shellcheck disable=SC2086
		set -- $body
		if [ "$#" = 4 ] && [ "$1 $2 $3" = "chef-gps 1 enabled" ]; then
			case "$4" in 0|1) echo "enabled $4"; return 0;; esac
		fi
		why="unknown format or version"
	fi
	[ "$rc" = 2 ] || log "gps: ignoring $f: $why"
	echo "enabled 1"
}

gps_save_locked() {
	f=$(gps_file)
	rm -f "$f".tmp.*
	if [ "$f" = "$GPS_FILE" ]; then
		d=${f%/*}
		mkdir -p "$d" && chmod 700 "$d" || { log "gps: cannot create $d"; return 1; }
	fi
	printf 'chef-gps 1\nenabled %s\n' "$1" | seal | put "$f" || { log "gps: writing $f failed"; return 1; }
	[ "$f" = "$GPS_FILE" ] || log "gps: /data is not ours; switch kept on /run until reboot"
}

gps_save() {
	case "${1:-}" in 0|1) ;; *) log "usage: chef-state gps-save 0|1"; return 1;; esac
	locked gps gps_save_locked "$1"
}

# ---------------------------------------------------------------- BLE sensors

# blesensd's sensor records: /data/v1/blesens/sensors when /data is ours,
# else a file on /run with the same format. "chef-blesens 1", then one line
# per sensor, sealed:
#   sensor ADDR KINDS DATE FLAG NAME
# ADDR upper-case hex, KINDS hr/power/csc comma-separated, DATE YYYY-MM-DD
# or -, FLAG - or forget (a removal blesensd has not confirmed yet), NAME
# 1 to 63 printable ASCII characters. At most 8 lines.
blesens_file() {
	if ours; then echo "$BLESENS_FILE"; else echo "$BLESENS_RUN_FILE"; fi
}

# Records (possibly none) on stdin: 0 if every line is one.
blesens_valid() {
	! LC_ALL=C grep -vxE 'sensor ([0-9A-F]{2}:){5}[0-9A-F]{2} (hr|power|csc)(,(hr|power|csc)){0,2} (-|[0-9]{4}-[0-9]{2}-[0-9]{2}) (-|forget) [ -~]{1,63}' >/dev/null
}

blesens_load() {
	f=$(blesens_file)
	body=$(unseal "$f" 2>/dev/null); rc=$?
	[ "$rc" != 1 ] || why=$(unseal "$f" 2>&1 >/dev/null)
	if [ "$rc" = 0 ]; then
		head=$(printf '%s\n' "$body" | head -n 1)
		recs=$(printf '%s\n' "$body" | sed '1d')
		n=$(printf '%s' "$recs" | grep -c '^' )
		if [ "$head" = "chef-blesens 1" ] && [ "$n" -le "$BLESENS_MAX" ] &&
		   printf '%s' "$recs" | blesens_valid; then
			[ -z "$recs" ] || printf '%s\n' "$recs"
			return 0
		fi
		why="unknown format or version"
	fi
	[ "$rc" = 2 ] || log "blesens: ignoring $f: $why"
	return 0
}

blesens_save_locked() {
	f=$(blesens_file)
	rm -f "$f".tmp.*
	if [ "$f" = "$BLESENS_FILE" ]; then
		d=${f%/*}
		mkdir -p "$d" && chmod 700 "$d" || { log "blesens: cannot create $d"; return 1; }
	fi
	if [ -z "$1" ]; then
		printf 'chef-blesens 1\n'
	else
		printf 'chef-blesens 1\n%s\n' "$1"
	fi | seal | put "$f" || { log "blesens: writing $f failed"; return 1; }
	[ "$f" = "$BLESENS_FILE" ] || log "blesens: /data is not ours; sensors kept on /run until reboot"
}

blesens_save() {
	recs=$(head -c 2049)
	n=$(printf '%s' "$recs" | grep -c '^')
	if [ "${#recs}" -gt 2048 ] || [ "$n" -gt "$BLESENS_MAX" ] || ! printf '%s' "$recs" | blesens_valid; then
		log "blesens: refusing to save invalid records"
		return 1
	fi
	locked blesens blesens_save_locked "$recs"
}

# ---------------------------------------------------------------- syslog

# This boot's sequence number: the boots.log(.1) line with this boot's id.
this_seq() {
	b=$(boot_id)
	[ "$b" != unknown ] || return 0
	cat "$CRASH/boots.log.1" "$CRASH/boots.log" 2>/dev/null | tr '\000' '#' |
		grep -E "$BOOT_LINE" | grep -F " boot_id=$b " | sed 's/^seq=\([0-9]*\) .*/\1/' | tail -n 1
}

# Oldest first: syslog-noseq-* by age (boots.log lost this boot's line,
# rare), then syslog-<seq> by number. Never $1, the file just written.
log_prune() {
	keep=${1##*/}
	files=$( (cd "$LOGDIR" && ls -1tr) 2>/dev/null | grep -E '^syslog-noseq-' | grep -vxF "$keep"
		(cd "$LOGDIR" && ls -1) 2>/dev/null | sed -n 's/^syslog-\([1-9][0-9]\{0,8\}\)$/\1/p' | sort -n |
			sed 's/^/syslog-/' | grep -vxF "$keep")
	n=$(( $(printf '%s\n' "$files" | grep -c .) + 1 ))
	for f in $files; do
		kb=$(du -sk "$LOGDIR" 2>/dev/null | cut -f1)
		[ "$n" -gt "$LOG_KEEP" ] || [ "${kb:-0}" -gt "$LOG_MAX_KB" ] || break
		rm -f "${LOGDIR:?}/$f" && n=$((n - 1)) && log "log: removed old $f"
	done
	sync "$LOGDIR"
}

log_save_locked() {
	rm -f "$LOGDIR"/.syslog.tmp.*
	mkdir -p "$LOGDIR" && chmod 700 "$LOGDIR" || { log "log: cannot create $LOGDIR"; return 1; }
	sync "${LOGDIR%/*}" || { log "log: cannot sync ${LOGDIR%/*}"; return 1; }
	seq=$(this_seq)
	f=$LOGDIR/syslog-${seq:-noseq-$(boot_id)}
	tmp=$LOGDIR/.syslog.tmp.$$
	if ! (umask 077 && logread > "$tmp") || ! sync "$tmp" || ! mv -f "$tmp" "$f" || ! sync "$LOGDIR"; then
		rm -f "$tmp"
		log "log: saving the syslog ring to $f failed"
		return 1
	fi
	log "log: saved the syslog ring to $f ($(wc -c < "$f") bytes)"
	log_prune "$f"
}

# Called with syslogd's state from before CHEF_LOG_KMSG_ONLY was set.
log_save() {
	cd / || return 1
	ours || { log "log: /data is not ours; syslog ring not saved"; return 0; }
	[ "$1" = up ] || { log "log: syslogd is not running; syslog ring not saved"; return 0; }
	locked log log_save_locked
}

# ---------------------------------------------------------------- shutdown

# Snapshot a PID's state and start time. Strip through the last closing
# parenthesis: comm may itself contain spaces or parentheses. Unreadable or
# malformed stat is unknown, never evidence that a live process stopped.
proc_state() {
	awk -v pid="$1" '$1 == pid && $0 ~ /^[0-9]+ \(.*\) / {
		sub(/^.*\) /, "")
		if (NF >= 20 && $1 ~ /^[RSDZTtXxKWPI]$/ && $20 ~ /^[0-9]+$/) print $1, $20
	}' "$PROC/$1/stat" 2>/dev/null
}

# pid:start-time tokens captured before TERM; start time distinguishes a
# reused PID from the original process. Unknown identities stay conservative.
pid_tokens() {
	for pid in "$@"; do
		info=$(proc_state "$pid")
		start=${info#* }
		[ -n "$info" ] || start=unknown
		printf '%s:%s\n' "$pid" "$start"
	done
}

# daemon_pids SERVICE PROGRAM: the pid of SERVICE's daemon as its supervisor
# records it, else every PROGRAM (pidof). The supervisor's record keeps out
# a client of the same binary (`sensord watch`, `powerd status`), which no
# stop of the service ends.
daemon_pids() {
	dpid=
	read -r dpid 2>/dev/null < "$RC_OPTIONS/$1/child_pid"
	case "$dpid" in
	''|*[!0-9]*) pidof "$2" 2>/dev/null ;;
	*) echo "$dpid" ;;
	esac
}

# rc_stop SERVICE...: stop each service through OpenRC, all at once in the
# background; never waits. A supervised daemon that anyone but its
# supervisor signals is respawned at once, so they are never signalled here.
rc_stop() {
	for svc in "$@"; do
		rc-service -q "$svc" stop </dev/null >/dev/null 2>&1 &
	done
}

# Wait (0.1 s steps, at most $1 tenths) for original processes to exit.
wait_gone() {
	n=$1; shift
	while :; do
		alive=
		for token in "$@"; do
			p=${token%%:*} original=${token#*:}
			kill -0 "$p" 2>/dev/null || continue
			info=$(proc_state "$p")
			state=${info%% *} start=${info#* }
			# Reaped or unreaped Z/X children cannot execute or write.
			case "$state" in Z|X|x) continue;; esac
			if [ -n "$info" ] && [ "$original" != unknown ] && [ "$start" != "$original" ]; then
				continue # the original exited and this PID was reused
			fi
			alive=1
		done
		[ -n "$alive" ] || return 0
		[ "$n" -gt 0 ] || return 1
		sleep 0.1
		n=$((n - 1))
	done
	return 1
}

# Any powerd alive (not zombie or dead)? Unreadable state counts as alive.
live_powerd() {
	for pid in $(pidof powerd 2>/dev/null); do
		state=$(proc_state "$pid")
		case "${state%% *}" in Z|X|x) ;; *) return 0;; esac
	done
	return 1
}

# Power log rows a powerd that is gone left in /run/chef/power/log.pending
# (normally none: powerd's exit flush on TERM appends and fsyncs them).
# Only when the powerd seen at entry ($@: its pid:start tokens) is
# confirmed gone and no other is alive, never while one may still write.
# `powerd ... flush` applies powerd's own rules (header, rotation, torn
# tail) and fsyncs; it runs as powerd, whose files these are, and logs to
# syslog (kmsg is root's). 0: nothing pending or flushed, 1: rows left
# (logged).
power_flush() {
	pending=$RUN/power/log.pending
	[ -s "$pending" ] || return 0
	rows=$(($(wc -l < "$pending")))
	if ! wait_gone 0 "$@" || live_powerd; then
		log "power: powerd may still be running; $rows pending rows left in $pending"
		return 1
	fi
	if timeout -k 1 2 "$SU" -s /bin/sh powerd -c \
		"CHEF_LOG_KMSG_ONLY=0 exec powerd -d '$RUN/power' -l '$DATA/v1/power' -L $POWER_LOG_MAX flush" </dev/null 8>&-; then
		log "power: appended $rows pending rows a stopped powerd left"
		return 0
	fi
	log "power: flushing $rows pending rows failed; left in $pending"
	return 1
}

# The shutdown screen's marker, written before anything that can block (and
# on a RAM-only boot too). Once present it stays as it is.
shutdown_marker() {
	reason=$1
	[ ! -e "$SHUTTING_DOWN" ] || return 0
	case "$reason" in
	poweroff|reboot) ;;
	'')
		if [ -e "$POWER_PENDING" ] || [ -e "$BUTTOND_HINT" ]; then reason=poweroff; else reason=unknown; fi;;
	*) log "shutdown: unknown reason '$reason'"; reason=unknown;;
	esac
	tmp=$SHUTTING_DOWN.$$
	if echo "$reason" > "$tmp" 2>/dev/null && chmod 0644 "$tmp" 2>/dev/null &&
	   mv -f "$tmp" "$SHUTTING_DOWN" 2>/dev/null; then
		return 0
	fi
	rm -f "$tmp" 2>/dev/null
	log "shutdown: cannot write $SHUTTING_DOWN"
}

do_shutdown() {
	cd / || return 1
	ours || return 0
	read -r t0 _ < "$PROC/uptime"
	sensors=$(daemon_pids sensord sensord)
	# shellcheck disable=SC2086
	sensor_tokens=$(pid_tokens $sensors)
	power=$(daemon_pids powerd powerd)
	# shellcheck disable=SC2086
	power_tokens=$(pid_tokens $power)
	# Powerd is not needed by time_save. Its in-flight sysfs read/reset can
	# finish while chronyc/RTC sampling runs, rather than serially after it.
	# The timekeeper's stop also ends a save of its own in flight (its
	# service TERMs the whole process group); a save killed before its
	# rename leaves only a temp file, which the next save removes.
	rc_stop sensord powerd chef-timekeeper
	# Never queue behind a save in flight (about 1 s at most), and keep the
	# save itself short: chronyc 1 s, one RTC edge (at most 1.1 s) 1.5 s.
	LOCK_TRIES=10 CHRONYC_SECS=1 EDGE_SECS=1.5 time_save; time_rc=$?
	chrony=$(pidof chronyd 2>/dev/null)
	# shellcheck disable=SC2086
	stop_tokens="$sensor_tokens $power_tokens $(pid_tokens $chrony)"
	rc_stop chronyd
	read -r stop_now _ < "$PROC/uptime"
	# Share a normal 1.8 s stop deadline with the time-save work; leave
	# about 0.2 s for the final small bias snapshot/sync in the usual case.
	# At least 0.3 s even when a slow time save used up the budget, so
	# chronyd can write its drift file (the 5 s hook bound has room).
	# The outer hook timeout still bounds failed/blocking I/O separately.
	stop_wait=$(awk -v a="$t0" -v b="$stop_now" 'BEGIN { n=int((1.8-(b-a))*10); if(n<3)n=3; if(n>18)n=18; print n }')
	# shellcheck disable=SC2086
	wait_gone "$stop_wait" $stop_tokens; stop_rc=$?
	[ "$stop_rc" = 0 ] || log "shutdown: chronyd/sensord/powerd not confirmed stopped by 1.8 s deadline; final flush not confirmed"
	# shellcheck disable=SC2086
	power_flush $power_tokens; power_rc=$?
	# as sensord, whose files these are; its lines go to syslog (kmsg is
	# root's), and log-save keeps the ring right after
	"$SU" -s /bin/sh sensord -c 'CHEF_LOG_KMSG_ONLY=0 CHEF_STATE_MAG_FINAL=1 exec /usr/bin/chef-state mag-save' </dev/null
	mag_rc=$?
	sync; sync_rc=$?
	read -r t1 _ < "$PROC/uptime"
	log "shutdown: time_save_rc=$time_rc (1=skipped/failed) power_flush_rc=$power_rc mag_save_rc=$mag_rc sync_rc=$sync_rc stop_rc=$stop_rc (uptime $t0 -> $t1)"
}

# Every command but ours may write in $ST.
[ "${1:-}" = ours ] || mkdir -p "$ST" 2>/dev/null

case "${1:-}" in
ours) ours;;
boot)
	cd / || exit 1
	time_restore
	crash_boot
	exit 0;;
timekeeper) timekeeper;;
time-save) time_save;;
mag-save) cd / && mag_save;;
mag-restore) [ "$#" = 2 ] || { log "usage: chef-state mag-restore FILE"; exit 1; }; cd / && mag_restore "$2";;
gps-load) cd / && gps_load;;
gps-save) cd / && gps_save "${2:-}";;
blesens-load) cd / && blesens_load;;
blesens-save) cd / && blesens_save;;
# kmsg only, for this and its own children: a hang on the way down is what
# pstore keeps, and only kmsg lines reach it (the flush and the bias save,
# run as their daemons, log to syslog).
shutdown) export CHEF_LOG_KMSG_ONLY=1; shutdown_marker "${2:-}"; do_shutdown; exit 0;;
# the same for the ring's save at the very end; its lines would land in the
# ring it is saving, after the copy
log-save)
	up=down
	! chef_log_syslogd_up || up=up
	export CHEF_LOG_KMSG_ONLY=1
	log_save "$up";;
*) log "usage: chef-state {ours|boot|timekeeper|time-save|mag-save|mag-restore FILE|gps-load|gps-save 0|1|blesens-load|blesens-save|shutdown [poweroff|reboot]|log-save}"; exit 1;;
esac
