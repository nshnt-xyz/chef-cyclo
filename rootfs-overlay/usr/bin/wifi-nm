#!/bin/sh
# Prepare NetworkManager's start: init.d/networkmanager's start_pre runs
# this (etc/conf.d/networkmanager) and passes what it prints, the
# --state-file argument, to NetworkManager. Any failure fails that start
# with the reason on stderr; none of these changes later in the boot.
# NM restarts independently; this never starts/restarts/kills modem support.
set -eu
. /usr/lib/chef/modem-owner.sh
fail() { echo "wifi-nm: $*" >&2; exit 1; }
touch /run/chef/wifi-nm-mode
wifi-usb-guard >&2 || fail 'USB ingress/routing protection failed'
[ -e /run/chef/udev-ready ] || fail 'udev coldplug did not complete'
[ ! -d /run/chef/wifi ] || fail 'manual Wi-Fi session owns WLAN'
# The wait gives up once `openrc shutdown` has begun (it sets the runlevel
# first): this start holds NetworkManager's lock, and the stop of dbus waits
# up to 60 s for it.
n=0
until [ -S /run/dbus/system_bus_socket ] && modem_owner_pid >/dev/null; do
    [ "$(cat /run/openrc/softlevel 2>/dev/null)" != shutdown ] || fail 'shutdown in progress; not starting'
    n=$((n+1)); [ "$n" -lt 600 ] || fail 'shared modem/system bus readiness timeout (no modem restart)'
    sleep 1
done
mkdir -p /run/NetworkManager/system-connections /run/wpa_supplicant
chmod 700 /run/NetworkManager/system-connections
wifi-prepare >&2 || fail 'firmware/module preparation failed'
# Publish NM mode before NetworkManager starts so diagnostic helpers cannot
# race its startup.
touch /run/chef/wifi-nm-mode
# The Wi-Fi switch (NetworkManager's WirelessEnabled) lives in NM's state
# file: on /data when it is ours, so it survives a reboot; else NM's
# default in the tmpfs /var.
state=/var/lib/NetworkManager/NetworkManager.state
if /usr/bin/chef-state ours; then state=/data/v1/networkmanager/NetworkManager.state; fi
echo "--state-file=$state"
