#!/bin/sh
# Log the Wi-Fi IPv4 address (tag chef-wifi-ip, `logread | grep
# chef-wifi-ip`): one line, whenever wlan0 comes up or its DHCP lease
# changes, so the phone can be found for SSH (docs/features/ssh.md). Runs after the overlap guard (10-), so an address
# it refused is normally gone already. Never fails the activation.
[ "${1:-}" = wlan0 ] || exit 0
case "${2:-}" in up|dhcp4-change) ;; *) exit 0 ;; esac
CHEF_LOG_KMSG=${CHEF_WIFI_IP_KMSG:-/dev/kmsg}
. "${CHEF_LIB_DIR:-/usr/lib/chef}/log.sh"
addrs=$(ip -4 -o addr show dev wlan0 2>/dev/null | awk '$3=="inet" {split($4,a,"/"); printf "%s%s", sep, a[1]; sep=" "}')
[ -n "$addrs" ] || exit 0
chef_log chef-wifi-ip "${CONNECTION_ID:-wlan0} IPv4 $addrs, ssh root@${addrs%% *}"
exit 0
