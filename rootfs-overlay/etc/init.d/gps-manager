#!/sbin/openrc-run
# GNSS on demand: idle until a client leases it on
# /run/chef/gps-manager/gps-manager.sock (`gps-manager hold map`), then runs
# the LOC session, gpsd and the NMEA pipeline on top of modem-up's modem;
# never starts or stops modem-up (docs/features/gps.md).

description="GNSS leases"
supervisor=supervise-daemon
command=/usr/bin/gps-manager
# As user gps (docs/features/users-and-permissions.md), and so are its
# qmicli, gpsd and nmea-broker: modem-up's lock and the QMUX bridge through
# the qmux group, NTP SHM unit 2 through chrony's (gpsd as non-root uses
# units 2 and up; chrony.conf).
command_user="gps:gps"
no_new_privs=yes

# After modem-up, so `openrc shutdown` stops it (and a lease's LOC session)
# before the modem goes.
depend() {
	use logger
	after modem-up
}

# Its directory (socket, logs, record) and chef-state's for the GPS switch
# (the lock, and the switch while /data is not ours), its own every start.
start_pre() {
	checkpath -d -o gps:gps -m 0750 /run/chef/gps-manager &&
		checkpath -d -o gps:gps -m 0700 /run/chef/state/gps
}
