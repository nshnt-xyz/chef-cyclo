#!/sbin/openrc-run
# Side buttons: grabs the power/volume evdev nodes and publishes gestures on
# /run/chef/buttond/buttond.sock; with nothing claiming them a short power
# press toggles the screen-off flag /run/chef/screen/off, and power held 3 s
# (buzz at 1.5 s, long buzz at 3 s) then released runs `poweroff`, the orderly
# way down through init (::shutdown, SIGTERM to all, RB_POWER_OFF). The
# PMIC hard-resets on its own at ~8.7 s held. `buttond watch` to look
# (docs/features/buttons-and-power-off.md).

description="Side buttons and power-off"
supervisor=supervise-daemon
command=/usr/bin/buttond
# Its own user (docs/features/users-and-permissions.md): the evdev nodes,
# the screen-off flag and the vibrator through its groups (input, screen,
# vibrator), CAP_KILL for `poweroff` (busybox signals init).
command_user="buttond:buttond"
capabilities="^cap_kill"
no_new_privs=yes

depend() {
	use logger
}

# Its socket's directory, its own every start.
start_pre() {
	checkpath -d -o buttond:buttond -m 0750 /run/chef/buttond
}
