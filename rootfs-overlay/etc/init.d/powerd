#!/sbin/openrc-run
# Battery: low-battery warn (15 %) / critical (5 %) and a clean poweroff when
# empty and unpowered or at 68 C, state in /run/chef/power (`powerd
# status`), the power_supply log in /data/v1/power (4 MiB + one rotation)
# when /data is ours, else in /run/chef/power (1 MiB), and the 44/42 C
# charge throttle on system_temp_level (docs/features/battery-and-charging.md).

description="Battery policy and power log"
supervisor=supervise-daemon
command=/usr/bin/powerd

depend() {
	use logger
}

# Its state directory, its own every start (world-readable: `powerd
# status`). The charge throttle's system_temp_level gets powerd's group
# here, not from a udev rule: /init leaves power_supply out of its coldplug
# (0.4 s for the battery alone). If that fails powerd's write fails too and
# it leaves the throttle disabled. The log on /data only when it is ours;
# chef-state's fallback flush at shutdown uses the same directory and size
# (a host test checks).
start_pre() {
	checkpath -d -o powerd:powerd -m 0755 /run/chef/power || return 1
	stl=/sys/class/power_supply/battery/system_temp_level
	chgrp powerd "$stl" && chmod 0664 "$stl" ||
		ewarn "powerd: $stl not writable for powerd; charge throttle disabled"
	command_args=
	if /usr/bin/chef-state ours; then
		command_args="-l /data/v1/power -L 4194304"
	fi
}
