#!/sbin/openrc-run
# The ADSP boot for the sensors (`sensors-up adsp`): starts audio-up, which
# boots the ADSP, unless it is ONLINE or audio-up is running; one-shot,
# nothing stays running under this service (audio-up is detached and keeps
# running as long as it needs to). sensord polls for the ADSP's sensor
# manager itself. Output: /run/chef/log/sensors-up.log.

description="ADSP boot for the sensors"

depend() {
	use logger
	need sensord
	# The modem stack first, as before: it also brings up /firmware and
	# the servreg-locator that audio-up then reuses.
	after modem-up
}

start() {
	ebegin "Booting the ADSP for the sensors"
	/usr/bin/sensors-up adsp >> /run/chef/log/sensors-up.log 2>&1
	eend $?
}
