# chronyd (the package's init.d/chronyd): client-only NTP, no network
# command port or server listener (etc/chrony/chrony.conf), logging to
# syslog. FAST_STARTUP: in the foreground (-n) under the supervisor; -u:
# runs as `chrony`. /init makes /run/chrony and /var/lib/chrony
# chrony:chrony 0700 (chef-storage binds /data/v1/chrony over the latter
# when /data is ours) before anything starts.
supervisor=supervise-daemon
FAST_STARTUP=yes
command_args="-u chrony"
# Group chrony from the start, still uid 0 with every capability until its
# own -u drop: the GPS refclock's SHM 2 segment is created before that drop
# and takes the creator's egid, so it comes out root:chrony 0660 and gpsd,
# as gps (in group chrony), can attach it (chrony.conf).
command_user="root:chrony"
# Its GPS refclock needs no network: start early, not after one (and there
# is no firewall service).
rc_need="!net"
rc_after="!firewall"
rc_use="logger"
