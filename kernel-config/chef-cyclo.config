# chef-cyclo kernel config, applied on top of Motorola's chef stack
# (sdm660_defconfig + moto-sdm660.config + moto-sdm660-chef.config).
CONFIG_LOCALVERSION="-cyclo"
# Android populates /dev with ueventd; we want the kernel to do it.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Android-only: restricts socket creation to members of AID_INET etc.
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# WCN3990 Bluetooth transport.  Firmware setup is initially exercised by the
# userspace bt-bringup probe; H4/QCA are built in for the later BlueZ attach.
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y

# Classic Bluetooth protocol layers, so ordinary BlueZ clients work as on a
# desktop distribution: rfcomm serial (/dev/rfcommN) and HFP's RFCOMM control
# link, PAN (BNEP), and kernel HIDP for input.conf UserspaceHID=false and
# legacy tools (bluetoothd's default classic HID path is uhid).
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
# Virtual HCI (/dev/vhci) for btvirt and the BlueZ test tools.
CONFIG_BT_HCIVHCI=y
# AF_ALG: BlueZ's src/shared/crypto.c (cmac(aes), ecb(aes)) and
# bluetooth-meshd need the userspace crypto socket interface. meshd also
# needs AEAD sockets for ccm(aes) (ell's l_aead_cipher); without them it
# exits with "Mesh Crypto functions unavailable".
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y

# System V IPC: gpsd hands NMEA time to chronyd through an NTP SHM segment
# (refclock SHM 0). Android disables it, so shmget() returned ENOSYS.
CONFIG_SYSVIPC=y
