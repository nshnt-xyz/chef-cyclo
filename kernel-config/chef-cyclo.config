# chef-cyclo kernel config, applied on top of Motorola's chef stack
# (sdm660_defconfig + moto-sdm660.config + moto-sdm660-chef.config).
CONFIG_LOCALVERSION="-cyclo"
# Android populates /dev with ueventd; we want the kernel to do it.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Android-only: restricts socket creation to members of AID_INET etc.
# CONFIG_ANDROID_PARANOID_NETWORK is not set
