# P04 reference values (layer after design.state): 14:16 IST on Thursday
# 8 October 2026, synchronised by GPS at 14:02. The clock is frozen from the
# epoch; the zone is the system's (/etc/localtime, Asia/Kolkata), or the
# saved settings' POSIX fallback (IST-5:30) where that file is missing.
clockepoch 1791449160
timesync gps 1791448320
