out/
*.o

# Cross toolchain, fetched by scripts/setup-toolchain.sh
toolchain/

# Ride and GPS captures can contain exact GPS coordinates. Keep the raw
# archives as local evidence only; commit the redacted README summary and
# text diagnostics.
