# Device backup: 11 GB of raw partition images, includes device-unique data (IMEI, MACs,
# calibration) and proprietary firmware. Never commit. Keep an offline copy instead.
stock/partitions/
stock/*.img

# Build output
out/
*.o

# Cross toolchain, fetched by scripts/setup-toolchain.sh
toolchain/

# Ride and GPS captures can contain exact GPS coordinates. Keep the raw
# archives as local evidence only; commit the redacted summary in
# docs/build-log.md and the text diagnostics under logs/.
logs/ride-live-test-*.tgz
logs/gpsd-live-test-*.tgz

# Build trees: every component Makefile writes its host, test and device
# outputs under its own build/, and the top-level Makefile its test logs
# under build/.
/build/
tools/build/
tools/rmtfs/build/
tools/servreg-locator/build/
tools/tftp/build/
tools/sensord/build/
tools/blesensd/build/
tools/buttond/build/
tools/gps-manager/build/
tools/powerd/build/
tools/common/build/
tools/chefui/build/
__pycache__/

# SSH authorized keys baked into the image (scripts/ssh-setup.sh,
# docs/features/ssh.md): host-specific, never committed.
secrets/
