# busybox init. /init has already done the mounts and USB gadget setup.
# The shell gets root's home and session bus (below) the way a desktop login would.
::respawn:/bin/sh -c 'export HOME=/root XDG_RUNTIME_DIR=/run/user/0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus; exec /usr/sbin/telnetd -F -b 172.16.42.1 -l /bin/sh'
::respawn:/usr/sbin/udhcpd -f /etc/udhcpd.conf
::respawn:/bin/sh -c 'if [ ! -e /run/dbus-helper-ready ]; then sleep 10; exit 1; fi; exec /usr/bin/dbus-daemon --system --nofork --nopidfile'
# A PAN link (bnep*) must not reach the root telnet on the USB subnet (Linux
# answers for 172.16.42.1 on any interface), the same rule wifi-usb-guard sets
# for wlan0. bluetoothd does not start without it.
::respawn:/bin/sh -c 'while [ ! -S /run/dbus/system_bus_socket ]; do sleep 1; done; iptables-legacy -w 5 -C INPUT -i bnep+ -d 172.16.42.0/24 -j DROP 2>/dev/null || iptables-legacy -w 5 -I INPUT 1 -i bnep+ -d 172.16.42.0/24 -j DROP || { echo "cyclo: BNEP ingress guard failed, bluetoothd not started" > /dev/kmsg; sleep 10; exit 1; }; exec /usr/lib/bluetooth/bluetoothd -n'
# Root's session bus at the standard XDG path, for session services such as
# obexd (bluez-obexd, D-Bus activated) and PipeWire run by hand, without
# dbus-run-session. Volatile.
::respawn:/bin/sh -c 'mkdir -p /run/user/0 && chmod 700 /run/user/0 || exit 1; export HOME=/root XDG_RUNTIME_DIR=/run/user/0; exec /usr/bin/dbus-daemon --session --nofork --nopidfile --address=unix:path=/run/user/0/bus'
::once:/bin/sh -c 'exec /usr/bin/gps-up > /run/gps-up.log 2>&1'
::respawn:/usr/bin/wifi-nm
# GNSS on demand: idle until a client leases it on /run/gps-manager.sock
# (`gps-manager hold map`), then runs the LOC session, gpsd and the NMEA
# pipeline on top of the gps-up modem; never starts or stops gps-up.
::respawn:/usr/bin/gps-manager
# Client-only NTP, no network command/server listener; state is volatile.
::respawn:/bin/sh -c 'mkdir -p /run/chrony && chown chrony:chrony /run/chrony && chmod 700 /run/chrony && exec /usr/sbin/chronyd -d -u chrony -f /etc/chrony/chrony.conf'
::respawn:/usr/bin/bt-up
# On-device boot/probe output: paints /dev/kmsg on the panel, read-only, no
# touch. Holds /dev/fb0 for the life of the boot (the panel is off otherwise).
# /run/fblog.off is the system-wide screen-off flag: `touch /run/fblog.off;
# kill $(pidof fblog)` idles it, removing the flag brings it back (fblog
# watches for that). Do not kill after removal: it can blank a just-woken
# daemon. Init respawn sees current flag if fblog is absent. It stays dark when a
# foreground client (chefui) exits with the flag present.
::respawn:/usr/bin/fblog
# Side buttons: grabs the power/volume evdev nodes and publishes gestures on
# /run/buttond.sock; with nothing claiming them a short power press toggles
# the panel through the screen-off flag above, and power held 3 s (buzz
# at 1.5 s, long buzz at 3 s) then released runs `poweroff` -- the orderly
# way down through this init (::shutdown, SIGTERM to all, RB_POWER_OFF).
# The PMIC hard-resets on its own at ~8.7 s held. `buttond watch` to look.
::respawn:/usr/bin/buttond
# Battery: low-battery warn (15 %) / critical (5 %) and a clean poweroff when
# empty and unpowered or at 68 C, the power_supply log + state in /run/power
# (`powerd status`), and the 44/42 C charge throttle on system_temp_level.
::respawn:/usr/bin/powerd
# A/B slot: mark boot_a successful once this boot has lasted 30 s, as
# Android's boot_control HAL did, so abl stops counting retries down (it
# would mark the slot unbootable after 7 boots). A build that dies earlier
# keeps counting and ends in fastboot. Logs to kmsg and /run/abslot.log.
::once:/bin/sh -c 'sleep 30; exec /usr/bin/abslot mark-successful >/dev/null'
::ctrlaltdel:/sbin/reboot
::shutdown:/usr/bin/chef-storage shutdown
::shutdown:/bin/umount -a -r
::restart:/bin/sh -c '/usr/bin/chef-storage shutdown; exec /sbin/init'
