# busybox init. /init has already done the mounts and USB gadget setup.
::respawn:/usr/sbin/telnetd -F -l /bin/sh
::respawn:/usr/sbin/udhcpd -f /etc/udhcpd.conf
::respawn:/usr/bin/dbus-daemon --system --nofork --nopidfile
::respawn:/bin/sh -c 'while [ ! -S /run/dbus/system_bus_socket ]; do sleep 1; done; exec /usr/lib/bluetooth/bluetoothd -n'
::respawn:/usr/bin/bt-up
# On-device boot/probe output: paints /dev/kmsg on the panel, read-only, no
# touch. Holds /dev/fb0 for the life of the boot (the panel is off otherwise);
# `touch /run/fblog.off; kill $(pidof fblog)` idles it, rm + kill brings it back.
::respawn:/usr/bin/fblog
# Side buttons: grabs the power/volume evdev nodes and publishes gestures on
# /run/buttond.sock; with nothing claiming them a short power press toggles
# the panel through the fblog.off protocol above, and power held 3 s (buzz
# at 1.5 s, long buzz at 3 s) then released runs `poweroff` -- the orderly
# way down through this init (::shutdown, SIGTERM to all, RB_POWER_OFF).
# The PMIC hard-resets on its own at ~8.7 s held. `buttond watch` to look.
::respawn:/usr/bin/buttond
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
::restart:/sbin/init
