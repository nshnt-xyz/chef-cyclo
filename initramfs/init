#!/bin/busybox sh
# chef-cyclo initramfs /init.
#
# The phone has no usable display or serial console at this stage, so this
# brings up a USB NCM network interface (phone = 172.16.42.1, DHCP for the
# host) and a root telnet shell on it, and hands over to busybox init.
# Progress is logged to the kernel log (readable later with dmesg) and
# signalled on the vibrator: one buzz when init starts, two when the USB
# network is up.

# Alpine's busybox packages create their applet links in a post-install
# trigger that mkrootfs.sh cannot run; do it here.
/bin/busybox --install -s
/bin/busybox-extras --install -s 2>/dev/null
export PATH=/sbin:/usr/sbin:/bin:/usr/bin

log()  { echo "cyclo-init: $*" > /dev/kmsg 2>/dev/null; }
buzz() { echo "$1" > /sys/class/timed_output/vibrator/enable 2>/dev/null; }

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev || { mount -t tmpfs tmpfs /dev; mdev -s; }
mkdir -p /dev/pts
mount -t devpts   devpts   /dev/pts
mount -t tmpfs    tmpfs    /tmp
mount -t tmpfs    tmpfs    /run
mount -t configfs configfs /sys/kernel/config
mkdir -p /run/dbus /var/lib/dbus
dbus-uuidgen --ensure 2>/dev/null

# apk --usermode/no-scripts and root-owned cpio omit the privileged activation
# helper metadata. Only the system-bus account may execute this root helper.
if chown root:messagebus /usr/libexec/dbus-daemon-launch-helper &&
   chmod 4750 /usr/libexec/dbus-daemon-launch-helper; then
    touch /run/dbus-helper-ready
else
    log "D-Bus launch-helper setup failed; system bus will remain unavailable"
fi

log "starting ($(uname -r))"
buzz 150

# gpsd and nmea-broker communicate over loopback, and gpsd's client socket is
# loopback-only by default. A bare initramfs does not configure lo for us.
if ip link set lo up 2>/dev/null &&
   { ip addr add 127.0.0.1/8 dev lo 2>/dev/null ||
     ip addr show dev lo 2>/dev/null | grep -q 'inet 127\.0\.0\.1/8'; }; then
    log "loopback up, 127.0.0.1/8"
else
    log "failed to configure loopback"
fi

# --- USB gadget: one NCM ethernet function, via configfs ------------------
SERIAL=chef
for a in $(cat /proc/cmdline); do
    case "$a" in
        androidboot.serialno=*) SERIAL="${a#*=}" ;;
    esac
done

G=/sys/kernel/config/usb_gadget/cyclo
if mkdir -p "$G"; then
    echo 0x1d6b > "$G/idVendor"      # Linux Foundation
    echo 0x0104 > "$G/idProduct"     # Multifunction Composite Gadget
    echo 0x0200 > "$G/bcdUSB"
    echo 0x0100 > "$G/bcdDevice"
    mkdir -p "$G/strings/0x409"
    echo "$SERIAL"                > "$G/strings/0x409/serialnumber"
    echo "chef-cyclo"             > "$G/strings/0x409/manufacturer"
    echo "Moto One Power (cyclo)" > "$G/strings/0x409/product"
    mkdir -p "$G/configs/c.1/strings/0x409"
    echo "ncm" > "$G/configs/c.1/strings/0x409/configuration"
    echo 500   > "$G/configs/c.1/MaxPower"
    mkdir -p "$G/functions/ncm.usb0"
    echo 02:43:59:43:4c:01 > "$G/functions/ncm.usb0/dev_addr"   # locally administered
    echo 02:43:59:43:4c:02 > "$G/functions/ncm.usb0/host_addr"
    ln -s "$G/functions/ncm.usb0" "$G/configs/c.1/"

    # The UDC (a800000.dwc3) can take a moment to register.
    i=0
    while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 100 ]; do
        sleep 0.1; i=$((i+1))
    done
    UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
    if [ -n "$UDC" ] && echo "$UDC" > "$G/UDC"; then
        log "gadget bound to $UDC"
    else
        log "no UDC found, USB gadget not started"
    fi
    IFACE=$(cat "$G/functions/ncm.usb0/ifname" 2>/dev/null)
else
    log "configfs usb_gadget unavailable"
fi

# --- network: static address on the gadget interface, DHCP for the host ---
IFACE=${IFACE:-usb0}
if ip link set "$IFACE" up 2>/dev/null; then
    ip addr add 172.16.42.1/24 dev "$IFACE"
    sed -i "s/^interface .*/interface $IFACE/" /etc/udhcpd.conf
    touch /tmp/udhcpd.leases
    log "$IFACE up, 172.16.42.1/24"
    buzz 150; sleep 0.3; buzz 150
else
    log "no $IFACE interface"
fi

printf '%s\n' "$IFACE" > /run/usb-interface

# Initialize native device metadata before NetworkManager starts. Preserve
# kernel names; packaged eudev has no predictive net-renaming rule. Coldplug
# net first: probing every storage/input device delayed boot and settle timed
# out on this kernel. Existing nodes remain devtmpfs (mdev fallback); new
# device events are still handled by the resident udev daemon.
mkdir -p /run/udev
if /sbin/udevd --daemon; then
    if udevadm trigger --action=add --subsystem-match=net && udevadm settle --timeout=20; then
        touch /run/udev-ready
    else
        log "network udev initialization failed; NetworkManager will remain unavailable"
    fi
    # Input classification (ID_INPUT_TOUCHSCREEN etc.) needs add events for
    # devices registered before udevd started. Run after net settle so an
    # input failure cannot hold up the NM readiness marker. Bound this
    # background task to 10 seconds; never wait for it before exec init.
    (
        log "input coldplug starting"
        if timeout -k 1 4 udevadm trigger --action=add --subsystem-match=input && udevadm settle --timeout=5; then
            touch /run/input-udev-ready
            log "input coldplug ready"
        else
            log "input coldplug failed or timed out; libinput discovery may be incomplete"
        fi
    ) &
else
    log "udev initialization failed; NetworkManager will remain unavailable"
fi

# Reserve WLAN ownership before any concurrent init consumers exist.
# No manual supplicant/DHCP may run in this standard-NM image, even on failure.
touch /run/wifi-nm-mode

# Hand over to busybox init: /etc/inittab keeps telnetd, udhcpd, dbus,
# bluetoothd and the Bluetooth attach (bt-up) running.
log "exec init"
exec /sbin/init
